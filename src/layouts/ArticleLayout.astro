---
import BaseLayout from "./BaseLayout.astro";
import { Download, Code2, Gauge, UserRound, Scale } from "lucide-astro";
const icons = {
  download: Download,
  code: Code2,
  gauge: Gauge,
  user: UserRound,
  license: Scale,
};
interface Props {
  title: string;
  description: string;
  eyebrow: string;
  icon?: keyof typeof icons;
  compactHeader?: boolean;
}
const {
  title,
  description,
  eyebrow,
  icon = "code",
  compactHeader = false,
} = Astro.props;
const Icon = icons[icon];
---

<BaseLayout title={`${title} — Mimic`} description={description}>
  <section
    class:list={[
      "container",
      "article-head",
      { "compact-head": compactHeader },
    ]}
  >
    <span class="eyebrow">
      <Icon size={18} />
      {eyebrow}
    </span>
    <h1>{title}</h1>
    <p>{description}</p>
  </section>
  <article class="container article-body prose">
    <slot />
  </article>
</BaseLayout>
<style>
  .article-head .eyebrow::before {
    display: none;
  }
  .article-body :global(.page-actions) {
    display: flex;
    gap: 14px;
    align-items: center;
    flex-wrap: wrap;
    margin-block: 0 32px;
  }
  .article-head {
    position: relative;
    isolation: isolate;
    padding-block: 70px 40px;
  }
  .article-head h1 {
    font-size: clamp(36px, 4vw, 64px);
    line-height: 1.1;
    letter-spacing: -0.045em;
    margin: 16px 0;
  }
  .article-head p {
    max-width: 800px;
    color: var(--muted);
    font-size: 18px;
  }
  .article-body {
    padding-bottom: 90px;
  }
  .article-body :global(pre) {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .article-body :global(table) {
    font-size: 14px;
  }
  .article-body :global(h1) {
    font-size: 28px;
  }
  .article-body :global(.button) {
    text-decoration: none;
  }
  @media (min-width: 1500px) {
    .article-body {
      font-size: 18px;
    }
    .article-head {
      padding-top: 95px;
    }
  }
  .article-head::before {
    content: "";
    position: absolute;
    inset: -50px -10% -20px;
    background: radial-gradient(ellipse at 65% 20%, #5075ff13, transparent 65%);
    z-index: -1;
    pointer-events: none;
  }
  .article-head h1 {
    font-family: var(--display);
    font-weight: 780;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .article-body :global(.page-actions a) {
    transition: color 0.2s;
  }
  @media (max-width: 1300px) {
    .article-head::before {
      inset-inline: -48px;
    }
  }
  @media (max-width: 760px) {
    .article-head::before {
      inset-inline: -18px;
    }
  }
  .article-head.compact-head {
    padding-top: 54px;
    padding-bottom: 18px;
  }
  .compact-head p {
    margin-bottom: 0;
  }
  @media (max-width: 760px) {
    .article-head.compact-head {
      padding-top: 36px;
    }
  }
</style>
