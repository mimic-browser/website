---
import ProductMotion from "@/components/ProductMotion.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ReleaseUpdater from "@/components/ReleaseUpdater.astro";
import { ClientRouter, fade } from "astro:transitions";
import "@fontsource-variable/inter";
import "@fontsource-variable/manrope";
import "@/styles/global.css";
interface Props {
  title: string;
  description: string;
  lang?: string;
  article?: { published: string; author: string };
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
}
const {
  title,
  description,
  lang = "en",
  article,
  image,
  imageAlt,
  imageWidth = 1200,
  imageHeight = 627,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const pathname =
  base && Astro.url.pathname.startsWith(`${base}/`)
    ? Astro.url.pathname.slice(base.length)
    : Astro.url.pathname;
const canonical = new URL(pathname, Astro.site);
const socialImage = new URL(image || "/og-image.png?v=d5820416", Astro.site);
const socialImageAlt =
  imageAlt ||
  "Mimic — Same web. Less weight. Lightweight browser automation, with the blue Mimic mascot.";
---

<!doctype html>
<html lang={lang} transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta property="og:type" content={article ? "article" : "website"} />
    {
      article && (
        <>
          <meta property="article:published_time" content={article.published} />
          <meta property="article:author" content={article.author} />
          <meta name="author" content={article.author} />
        </>
      )
    }
    <slot name="head" />
    <meta property="og:site_name" content="Mimic" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta
      property="og:image:type"
      content={socialImage.pathname.endsWith(".webp")
        ? "image/webp"
        : "image/png"}
    />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <meta
      name="google-site-verification"
      content="spfGC2Oq1vrSBy3_qDk_rjoHh_0nViUYeg7eWMvtom8"
    />
    <meta name="theme-color" content="#111719" />
    <link rel="canonical" href={canonical} />
    <link
      rel="icon"
      type="image/png"
      sizes="96x96"
      href={`${import.meta.env.BASE_URL}favicon.png`}
    />
    <title>{title}</title>
    <ClientRouter fallback="swap" />
    <script
      is:inline
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token":"359417a4f49a4a7585aa5d4a6aa5113a"}'></script>
  </head>
  <body>
    <a class="skip-link" href="#main"
      >{lang === "ru" ? "Перейти к содержимому" : "Skip to content"}</a
    >
    <div class="site-frame">
      <Header />
      <main
        id="main"
        transition:name="page-content"
        transition:animate={fade({ duration: "140ms" })}
      >
        <slot />
      </main>
      <Footer />
      <ProductMotion /><ReleaseUpdater />
    </div>
  </body>
</html>
