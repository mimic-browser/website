---
import BaseLayout from "./BaseLayout.astro";
import DocsSearch from "@/components/DocsSearch.astro";
import { releaseTag } from "@/lib/release";
import { BookOpen } from "lucide-astro";
import {
  documentationTopics,
  documentationCategories,
} from "@/lib/documentation";

interface Props {
  title: string;
  description: string;
  heading?: string;
  topics?: readonly (readonly [string, string])[];
  readingSequence?: readonly { title: string; path: string }[];
}
const {
  title,
  description,
  heading,
  topics = [],
  readingSequence,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const guideGroups = documentationCategories.map((category) => ({
  ...category,
  guides: documentationTopics.filter(
    (topic) =>
      topic.hub !== false &&
      topic.category === category.id &&
      topic.path.startsWith("docs/"),
  ),
}));
const isCurrent = (path: string) =>
  Astro.url.pathname.replace(/\/?$/, "/").endsWith(`/${path}`);
const currentGuide = documentationTopics.find((topic) => isCurrent(topic.path));
const currentGroup = guideGroups.find(
  (group) => group.id === currentGuide?.category,
);
const sequence = readingSequence ?? currentGroup?.guides ?? [];
const currentIndex = sequence.findIndex((guide) => isCurrent(guide.path));
const previous = currentIndex > 0 ? sequence[currentIndex - 1] : undefined;
const next = currentIndex >= 0 ? sequence[currentIndex + 1] : undefined;
---

<BaseLayout title={`${title} — Mimic Docs`} description={description}>
  <div
    class:list={["docs-shell", "container", { "has-toc": topics.length > 0 }]}
  >
    <aside class="docs-index">
      <a class="docs-home" href={`${base}docs/`}>
        Docs <BookOpen size={16} />
      </a>
      <div class="docs-search-row">
        <DocsSearch id="docs-reader-search" compact />
      </div>
      <div class="docs-mobile-nav">
        <label for="docs-page">Browse documentation</label>
        <select id="docs-page" aria-label="Documentation page">
          <option value={`${base}docs/`}>Documentation home</option>
          {
            guideGroups.map((group) => (
              <optgroup label={group.label}>
                {group.guides.map((guide) => (
                  <option
                    value={`${base}${guide.path}`}
                    selected={isCurrent(guide.path)}
                  >
                    {guide.title}
                  </option>
                ))}
              </optgroup>
            ))
          }
          {
            readingSequence && !currentGuide && (
              <option value={Astro.url.pathname} selected>
                {title}
              </option>
            )
          }
        </select>
      </div>
      <nav class="docs-guide-nav" aria-label="Documentation pages">
        {
          guideGroups.map((group) => (
            <details
              class="nav-group"
              open={group.guides.some((guide) => isCurrent(guide.path))}
            >
              <summary>{group.label}</summary>
              {group.guides.map((guide) => (
                <a
                  href={`${base}${guide.path}`}
                  aria-current={isCurrent(guide.path) ? "page" : undefined}
                >
                  {guide.title}
                </a>
              ))}
            </details>
          ))
        }
      </nav>
      <div class="docs-release">
        <span>Current release</span>{" "}
        <strong data-release-version>{releaseTag}</strong>{" "}
        <small>Windows & Linux amd64</small>
      </div>
    </aside>
    <div class="docs-reader">
      <header class="docs-intro">
        <span class="eyebrow">{currentGroup?.label ?? "Documentation"}</span>
        <h1>
          {heading ?? (title === "Documentation" ? "Build with Mimic." : title)}
        </h1>
        <p>{description}</p>
      </header>
      {
        topics.length > 0 && (
          <details class="docs-local-contents">
            <summary>On this page</summary>
            <nav aria-label="Page contents">
              {topics.map(([label, id]) => (
                <a href={`#${id}`}>{label}</a>
              ))}
            </nav>
          </details>
        )
      }
      <article class="docs-content prose">
        <slot />
      </article>
      {
        (previous || next) && (
          <nav class="docs-pagination" aria-label="Continue reading">
            {previous && (
              <a href={`${base}${previous.path}`} rel="prev">
                <span>← Previous</span> <strong>{previous.title}</strong>
              </a>
            )}
            {next && (
              <a class="next" href={`${base}${next.path}`} rel="next">
                <span>Next →</span> <strong>{next.title}</strong>
              </a>
            )}
          </nav>
        )
      }
    </div>
    {
      topics.length > 0 && (
        <aside class="docs-toc">
          <span>On this page</span>
          <nav aria-label="Documentation sections">
            {topics.map(([label, id]) => (
              <a href={`#${id}`}>{label}</a>
            ))}
          </nav>
        </aside>
      )
    }
  </div>
</BaseLayout>
<script>
  function initializeDocsNavigation() {
    const select = document.querySelector<HTMLSelectElement>("#docs-page");
    if (!select || select.dataset.ready) return;
    select.dataset.ready = "true";
    select.addEventListener("change", () => {
      location.href = select.value;
    });
  }
  initializeDocsNavigation();
  document.addEventListener("astro:page-load", initializeDocsNavigation);
</script>

<style>
  .docs-shell {
    display: grid;
    grid-template-columns: 228px minmax(0, 880px);
    justify-content: center;
    align-items: start;
    gap: 40px;
    padding-top: 32px;
    padding-bottom: 76px;
  }
  .docs-reader {
    min-width: 0;
  }
  .docs-intro {
    padding: 0 0 24px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 24px;
  }
  .docs-intro h1 {
    margin: 8px 0 12px;
    font-size: clamp(2rem, 3.5vw, 3.1rem);
    line-height: 1.12;
    letter-spacing: -0.045em;
  }
  .docs-intro p {
    max-width: 720px;
    margin: 0;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.65;
  }
  .docs-content {
    min-width: 0;
    font-size: 16px;
    line-height: 1.75;
  }
  .docs-content :global(> :first-child),
  .docs-content :global(> div > :first-child) {
    margin-top: 0;
  }
  .docs-content :global(h2) {
    margin-top: 38px;
    padding-top: 22px;
    font-size: 1.65rem;
  }
  .docs-content :global(.code-window) {
    margin: 20px 0;
  }
  .docs-content :global(.code-window + .code-window) {
    margin-top: -8px;
  }
  .docs-content :global(.doc-overview),
  .docs-content :global(.api-card) {
    margin: 0 0 28px;
    padding: 21px 23px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
  }
  .docs-content :global(.doc-overview p) {
    margin: 0;
  }
  .docs-content :global(.callout) {
    margin: 24px 0;
    padding: 16px 18px;
    border-left: 2px solid var(--blue);
    border-radius: 10px;
    background: #171e34;
    color: var(--muted);
  }
  .docs-content :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
  }
  .docs-content :global(th),
  .docs-content :global(td) {
    overflow-wrap: normal;
    word-break: normal;
  }
  .docs-content :global(th code),
  .docs-content :global(td code) {
    white-space: nowrap;
  }
  .docs-content :global(.command-grid) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 22px;
  }
  .docs-content :global(.api-card h3) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 9px;
    margin: 0 0 8px;
    font-size: 0.98rem;
  }
  .docs-content :global(.api-card h3 code) {
    color: var(--blue-bright);
  }
  .docs-content :global(.tag) {
    padding: 3px 7px;
    border: 1px solid var(--line);
    border-radius: 12px;
    color: var(--quiet);
    font: 650 0.65rem var(--sans);
    text-transform: uppercase;
  }
  .docs-content :global(.tag.core) {
    border-color: var(--blue);
    color: var(--blue-bright);
  }
  .docs-content :global(.api-card p) {
    margin: 6px 0;
    font-size: 0.89rem;
  }
  .docs-content :global(.signature) {
    color: var(--quiet);
    font-family: var(--mono);
    font-size: 0.76rem;
    overflow-wrap: anywhere;
  }
  .docs-content :global(details > summary) {
    cursor: pointer;
  }
  .docs-content :global(.faq-item) {
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 18px 22px;
    margin: 12px 0;
    background: var(--surface);
  }
  .docs-content :global(.faq-item summary) {
    font-weight: 650;
  }
  .docs-content :global(.faq-item p) {
    margin-bottom: 0;
  }

  .docs-index {
    position: sticky;
    top: 94px;
    min-width: 0;
    max-height: calc(100dvh - 118px);
    overflow-y: auto;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: #101625;
    scrollbar-width: thin;
  }
  .docs-home {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 2px;
    color: var(--text);
    font-size: 0.95rem;
    font-weight: 700;
  }
  .docs-search-row {
    margin: 14px 0 20px;
  }
  .docs-search-row :global(.search-trigger) {
    gap: 7px;
    padding: 9px;
    font-size: 0.75rem;
  }
  .docs-search-row :global(.search-trigger kbd) {
    padding: 2px 3px;
    font-size: 0.62rem;
  }
  .nav-group {
    margin: 10px 0 14px;
  }
  .nav-group summary {
    cursor: pointer;
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 650;
    margin-bottom: 6px;
  }
  .nav-group[open] summary {
    color: var(--text);
  }
  .docs-guide-nav a,
  .docs-toc a,
  .docs-local-contents a {
    display: block;
    padding: 6px 10px;
    border-left: 1px solid var(--line);
    color: var(--quiet);
    font-size: 0.79rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .docs-guide-nav a:hover,
  .docs-guide-nav a:focus-visible,
  .docs-toc a:hover,
  .docs-toc a:focus-visible,
  .docs-local-contents a:hover,
  .docs-local-contents a:focus-visible {
    color: var(--text);
    border-color: var(--blue);
  }
  .docs-guide-nav a[aria-current="page"] {
    color: var(--blue-bright);
    background: #202a42;
    border-color: var(--blue-bright);
  }
  .docs-release {
    display: flex;
    flex-direction: column;
    gap: 3px;
    margin-top: 20px;
    padding-top: 15px;
    border-top: 1px solid var(--line);
  }
  .docs-release span,
  .docs-release small {
    color: var(--quiet);
    font-size: 0.72rem;
  }
  .docs-release strong {
    color: var(--blue-bright);
    font-size: 0.96rem;
  }
  .docs-toc {
    display: none;
    position: sticky;
    top: 96px;
    min-width: 0;
    max-height: calc(100dvh - 122px);
    overflow-y: auto;
    scrollbar-width: thin;
  }
  .docs-toc > span {
    display: block;
    margin-bottom: 13px;
    color: var(--text);
    font-size: 0.77rem;
    font-weight: 650;
  }
  .docs-toc a {
    padding-block: 5px;
    font-size: 0.75rem;
  }
  .docs-local-contents {
    margin: 0 0 24px;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
  }
  .docs-local-contents summary {
    cursor: pointer;
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 650;
  }
  .docs-local-contents nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4px 20px;
    margin-top: 12px;
  }
  .docs-pagination {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 42px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .docs-pagination a {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 15px 17px;
    border: 1px solid var(--line);
    border-radius: 9px;
    background: var(--surface);
  }
  .docs-pagination a:hover {
    border-color: var(--blue);
  }
  .docs-pagination span {
    color: var(--quiet);
    font-size: 0.74rem;
  }
  .docs-pagination strong {
    color: var(--text);
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.5;
  }
  .docs-pagination .next {
    grid-column: 2;
    text-align: right;
  }
  .docs-mobile-nav {
    display: none;
  }
  @media (min-width: 1320px) {
    .docs-shell.has-toc {
      grid-template-columns: 228px minmax(0, 820px) 180px;
      gap: 32px;
    }
    .docs-toc {
      display: block;
    }
    .docs-local-contents {
      display: none;
    }
  }
  @media (max-width: 1050px) {
    .docs-shell {
      grid-template-columns: 208px minmax(0, 1fr);
      gap: 26px;
    }
    .docs-index {
      padding: 13px;
    }
  }
  @media (max-width: 760px) {
    .docs-shell {
      display: block;
      padding-top: 20px;
      padding-bottom: 52px;
    }
    .docs-index {
      position: static;
      max-height: none;
      overflow: visible;
      border: 0;
      background: transparent;
      padding: 0;
      margin-bottom: 24px;
    }
    .docs-index .docs-home,
    .docs-guide-nav,
    .docs-release {
      display: none;
    }
    .docs-search-row {
      margin: 0 0 12px;
    }
    .docs-search-row :global(.search-trigger) {
      font-size: 0.82rem;
      padding: 10px 12px;
    }
    .docs-mobile-nav {
      display: flex;
      flex-direction: column;
      gap: 6px;
      color: var(--muted);
      font-size: 0.76rem;
    }
    .docs-mobile-nav select {
      width: 100%;
      min-width: 0;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: var(--surface);
      color: var(--text);
      padding: 10px 12px;
      font: inherit;
    }
    .docs-intro {
      padding-bottom: 19px;
      margin-bottom: 20px;
    }
    .docs-intro h1 {
      font-size: 2rem;
    }
    .docs-intro p {
      font-size: 0.94rem;
    }
    .docs-content {
      font-size: 15.5px;
    }
    .docs-content :global(h2) {
      font-size: 1.45rem;
    }
    .docs-content :global(.command-grid) {
      grid-template-columns: 1fr;
    }
    .docs-local-contents nav {
      grid-template-columns: 1fr;
    }
    .docs-pagination {
      gap: 10px;
      margin-top: 30px;
    }
    .docs-pagination a {
      padding: 12px;
    }
  }
</style>
