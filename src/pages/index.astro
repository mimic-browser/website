---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeroDownload from "@/components/HeroDownload.astro";
import HowItWorks from "@/components/HowItWorks.astro";
import ToolMark from "@/components/ToolMark.astro";
import CodeWindow from "@/components/CodeWindow.astro";
import LanguageIcon from "@/components/LanguageIcon.astro";
import {
  ArrowRight,
  Github,
  Cpu,
  Wifi,
  Layers,
  Fingerprint,
  Globe,
  Server,
  ShieldCheck,
  Code,
  Play,
  Mail,
  Terminal,
  Box,
} from "lucide-astro";
const examples = {
  terminal: {
    label: "Terminal",
    lang: "bash",
    code: `mimic optimize --name shop -- node scraper.js

# Reuse your saved workload profile
mimic --profile shop`,
  },
  python: {
    label: "Python",
    lang: "python",
    code: `import os
from playwright.sync_api import sync_playwright

url = os.getenv("MIMIC_CDP_URL")
url = url or "http://localhost:9222"
with sync_playwright() as p:
    browser = p.chromium.connect_over_cdp(url)`,
  },
  node: {
    label: "Node.js",
    lang: "javascript",
    code: `import { chromium } from "playwright-core";

const url = process.env.MIMIC_CDP_URL
  ?? "http://localhost:9222";
const browser = await chromium.connectOverCDP(url);
const page = await browser.contexts()[0].newPage();`,
  },
  cdp: {
    label: "Raw CDP",
    lang: "json",
    code: `{
  "id": 1,
  "method": "Runtime.evaluate",
  "params": { "expression": "document.title" }
}`,
  },
};
const base = import.meta.env.BASE_URL;
const repo = "https://github.com/mimic-browser/runtime";
const capabilities = [
  {
    icon: Fingerprint,
    title: "Consistent fingerprints",
    text: "Browser signals stay coherent across your workflow.",
  },
  {
    icon: Server,
    title: "Your proxies",
    text: "Keep your existing proxy and rotation setup.",
  },
  {
    icon: Globe,
    title: "Dynamic websites",
    text: "JavaScript, page state, cookies and navigation.",
  },
  {
    icon: ShieldCheck,
    title: "Tested against Chrome",
    text: "Compatibility measured against real browser behavior.",
  },
];
---

<BaseLayout
  title="Mimic — Lightweight Browser for Web Scraping & Automation"
  description="Run browser automation with less memory, compute and network traffic. Mimic keeps the browser behavior your workload needs, without a full browser."
>
  <div class="hero-intro">
    <section
      class="hero"
      style={`--hero-room: url('${base}images/mascot-hero-detail.png')`}
    >
      <picture class="hero-art">
        <source
          media="(max-width: 600px)"
          srcset={`${base}images/mascot-hero-mobile-detail.png`}
          type="image/png"
        />
        <img
          src={`${base}images/mascot-hero-detail.png`}
          width="1672"
          height="941"
          alt="Mimic holding a browser window"
          fetchpriority="high"
        />
      </picture>
      <div class="container hero-layout">
        <div class="hero-content">
          <span class="eyeline">Browser automation, without the excess.</span>
          <h1>Same web.<br /><em data-text="Less weight.">Less weight.</em></h1>
          <p>
            Run browser automation with less memory, compute and network
            traffic. Mimic keeps the browser behavior your workload needs —
            without carrying the cost of a full browser.
          </p>
          <div class="actions">
            <HeroDownload />
            <button class="button how-button" type="button" data-how-open
              ><Play size={15} /> See how it works</button
            >
          </div>
          <div class="hero-tags">
            <span><Code size={13} /> Use your existing tools</span><span
              ><Server size={13} /> Use your proxies</span
            ><span><Box size={13} /> No Chrome install</span>
          </div>
        </div>
      </div>
    </section>
    <section class="benefit-band" id="features">
      <div class="container unified-benefits" id="benchmarks">
        <div class="unified-grid">
          <article>
            <h3><Cpu size={22} /> Less browser work</h3>
            <strong>5.0×</strong>
            <p>Less CPU per static session.</p>
            <div
              class="metric-comparison"
              aria-hidden="true"
              style="--usage: 20%"
            >
              <div><span>Chrome</span><i class="metric-baseline"></i></div>
              <div><span>Mimic</span><i class="metric-result"></i></div>
            </div>
            <small>Static DOM · 39 ms vs. Chrome: 195 ms</small>
          </article>
          <article>
            <h3><Layers size={22} /> More room to work</h3>
            <strong>8.3×</strong>
            <p>Less memory at startup.</p>
            <div
              class="metric-comparison"
              aria-hidden="true"
              style="--usage: 12.1%"
            >
              <div><span>Chrome</span><i class="metric-baseline"></i></div>
              <div><span>Mimic</span><i class="metric-result"></i></div>
            </div>
            <small>Process-tree RSS · 46 MiB vs. Chrome: 380 MiB</small>
          </article>
          <article>
            <h3><Wifi size={22} /> Only the traffic you need</h3>
            <strong>98.1%</strong>
            <p>
              Less downloaded with <a href={`${base}optimize/`}>Optimize</a>.
            </p>
            <div
              class="metric-comparison"
              aria-hidden="true"
              style="--usage: 1.855%"
            >
              <div><span>Chrome</span><i class="metric-baseline"></i></div>
              <div><span>+ Optimize</span><i class="metric-result"></i></div>
            </div>
            <small>Books extraction · vs. Chrome · body bytes</small>
          </article>
        </div>
        <a class="unified-methodology" href={`${base}benchmarks/`}
          >Results &amp; methodology <ArrowRight size={16} /></a
        >
      </div>
    </section>
  </div>
  <section class="behavior-band">
    <div class="container behavior-layout">
      <div class="behavior-intro">
        <span class="eyeline">Real browser behavior</span><h2>
          Built to work<br />on the real web.
        </h2><p>
          Run JavaScript, interact with pages and keep your existing browser
          workflow.
        </p><a class="text-link" href={`${base}docs/#compatibility`}
          >Explore compatibility <ArrowRight size={17} /></a
        >
      </div>
      <div class="capabilities">
        {
          capabilities.map(({ icon: Icon, title, text }) => (
            <article>
              <>
                <div class="capability-symbol">
                  <Icon size={35} />
                </div>
                <div>
                  <>
                    <h3>{title}</h3>
                    <p>{text}</p>
                  </>
                </div>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  <section class="container section-compact optimize-section">
    <div>
      <span class="eyeline">Optimize</span><h2>Let Mimic figure it out.</h2><p>
        Run your automation. Mimic tests what it can stop downloading, checks
        the result with your own assertions, and saves a reusable profile.
      </p><a class="button button-primary" href={`${base}optimize/`}
        >Explore Optimize <ArrowRight size={17} /></a
      >
    </div><ol class="steps">
      <li>
        <span>1</span><h3>Run your workload</h3><p>
          Use your existing script or tool.
        </p>
      </li><li>
        <span>2</span><h3>Mimic tests locally</h3><p>
          Try alternatives without repeatedly visiting the site.
        </p>
      </li><li>
        <span>3</span><h3>Reuse the profile</h3><p>
          Apply what passed. Keep your assertions in place.
        </p>
      </li>
    </ol>
  </section>
  <section class="tools-band" id="use-cases">
    <div class="container section-compact tools-section">
      <div>
        <span class="eyeline">Your tools. Unchanged.</span><h2>
          Use what you<br />already know.
        </h2><p>
          Connect with Playwright, Puppeteer or another CDP client. No new SDK.
          Keep your language, your code and your workflow.
        </p><div class="tool-chips">
          {
            ["Playwright", "Puppeteer", "Selenium", "Python", "Node.js"].map(
              (name) => (
                <a href={`${base}examples/`}>
                  <>
                    <ToolMark name={name} />
                    <span>{name}</span>
                  </>
                </a>
              ),
            )
          }<a href={`${base}examples/`} class="more-tools">… and more</a>
        </div><a class="text-link" href={`${base}examples/`}
          >See connection examples <ArrowRight size={15} /></a
        >
      </div><div class="terminal">
        <div
          class="example-tabs"
          role="tablist"
          aria-label="Automation examples"
        >
          {
            Object.entries(examples).map(([key, example], i) => (
              <button
                type="button"
                role="tab"
                data-example={key}
                id={`example-tab-${key}`}
                aria-controls={`example-panel-${key}`}
                aria-selected={i === 0}
                tabindex={i === 0 ? 0 : -1}
              >
                {key === "terminal" ? (
                  <Terminal size={15} />
                ) : (
                  <LanguageIcon language={key} />
                )}{" "}
                {example.label}
              </button>
            ))
          }
        </div>
        {
          Object.entries(examples).map(([key, example], i) => (
            <div
              role="tabpanel"
              id={`example-panel-${key}`}
              aria-labelledby={`example-tab-${key}`}
              hidden={i !== 0}
            >
              <CodeWindow
                code={example.code}
                lang={example.lang}
                title={example.label}
                showcase
              />
            </div>
          ))
        }
        <a href={`${base}docs/optimize/`}
          >Optimize your workload <ArrowRight size={14} /></a
        >
      </div>
    </div>
  </section>
  <section class="closing">
    <div class="container closing-inner">
      <img src={`${base}images/mascot-overlook.webp`} alt="" loading="lazy" />
      <div>
        <span class="eyeline">Built for a wider web</span><h2>
          Automation without<br />the overhead.
        </h2><p>
          For work where the result is data and browser behavior. A lighter way
          to get the job done.
        </p><div class="actions">
          <a class="button button-primary" href={`${base}download/`}
            >Download Mimic <ArrowRight size={16} /></a
          ><a class="button" href={repo}><Github size={17} /> View on GitHub</a>
        </div>
      </div>
    </div>
  </section>
  <section class="container support" id="contact">
    <div>
      <span class="eyeline">Integration support</span><h2>
        Bring your real workload.
      </h2><p>
        Need help getting started? Let's check compatibility and find where
        Mimic fits your setup.
      </p>
    </div><a class="support-email" href="mailto:slava@mimic.boo"
      ><Mail size={22} /><span
        ><strong>Talk to the builder</strong><small>slava@mimic.boo</small
        ></span
      ><ArrowRight size={19} /></a
    >
  </section>
  <section class="container guides" aria-label="Automation guides">
    <span>Start with a real example</span><p>
      Read <a href={`${base}playwright-without-chromium/`}
        >Run Playwright without Chromium</a
      > for a complete extraction example, or <a
        href={`${base}mimic-vs-chromium/`}>Mimic versus Chromium</a
      > for workload selection and measured memory boundaries.
    </p><a href={`${base}blog/`}>From the blog <ArrowRight size={14} /></a>
  </section>
  <HowItWorks />
</BaseLayout>
<script>
  function initHowDialog() {
    const dialog = document.querySelector<HTMLDialogElement>("#how-dialog");
    const trigger =
      document.querySelector<HTMLButtonElement>("[data-how-open]");
    if (!dialog || !trigger || trigger.dataset.initialized) return;
    trigger.dataset.initialized = "true";
    trigger.addEventListener("click", () => dialog.showModal());
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) {
        const r = dialog.getBoundingClientRect();
        if (
          event.clientX < r.left ||
          event.clientX > r.right ||
          event.clientY < r.top ||
          event.clientY > r.bottom
        )
          dialog.close();
      }
    });
    dialog.addEventListener("close", () => trigger.focus());
  }
  function initExamples() {
    const tabs = [
      ...document.querySelectorAll<HTMLButtonElement>("[data-example]"),
    ];
    function select(tab: HTMLButtonElement) {
      tabs.forEach((item) => {
        const active = item === tab;
        item.setAttribute("aria-selected", String(active));
        item.tabIndex = active ? 0 : -1;
        document
          .getElementById(`example-panel-${item.dataset.example}`)
          ?.toggleAttribute("hidden", !active);
      });
    }
    tabs.forEach((tab) => {
      if (tab.dataset.initialized) return;
      tab.dataset.initialized = "true";
      tab.addEventListener("click", () => select(tab));
      tab.addEventListener("keydown", (event) => {
        if (event.ctrlKey || event.metaKey || event.altKey) return;
        if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key))
          return;
        event.preventDefault();
        const i =
          event.key === "Home"
            ? 0
            : event.key === "End"
              ? tabs.length - 1
              : (tabs.indexOf(tab) +
                  (event.key === "ArrowRight" ? 1 : -1) +
                  tabs.length) %
                tabs.length;
        select(tabs[i]);
        tabs[i].focus();
      });
    });
  }
  initExamples();
  document.addEventListener("astro:page-load", initExamples);
  initHowDialog();
  document.addEventListener("astro:page-load", initHowDialog);
  document.addEventListener("astro:before-swap", () =>
    document.querySelector<HTMLDialogElement>("#how-dialog")?.close(),
  );
</script>
<style>
  .eyeline {
    display: block;
    font: 11px var(--mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #8ea9ff;
    margin-bottom: 16px;
  }
  h1,
  h2,
  h3,
  p {
    margin: 0;
  }
  h1,
  h2,
  h3 {
    font-family: "Manrope Variable", var(--sans);
  }
  h1 {
    font-size: clamp(58px, 6.5vw, 86px);
    line-height: 1.01;
    letter-spacing: -0.055em;
    font-weight: 800;
  }
  h1 em {
    position: relative;
    display: inline-block;
    font-style: normal;
    color: var(--blue);
    text-shadow: 0 2px 28px #395bfa27;
  }
  h1 em::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    color: transparent;
    text-shadow: none;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0.34;
    background: radial-gradient(
      ellipse at center,
      #b9c9ff 0%,
      #9db3ff 38%,
      transparent 74%
    );
    background-size: 48% 155%;
    background-repeat: no-repeat;
    background-position: -60% 50%;
    background-clip: text;
    -webkit-background-clip: text;
    animation: weight-glimmer 7s ease-in-out infinite alternate;
  }
  @keyframes weight-glimmer {
    to {
      background-position: 160% 50%;
    }
  }
  h2 {
    font-size: clamp(32px, 3.3vw, 44px);
    line-height: 1.12;
    letter-spacing: -0.035em;
    font-weight: 780;
  }
  h3 {
    font-size: 17px;
    letter-spacing: -0.015em;
    font-weight: 730;
  }
  p {
    color: #becbe1;
    font-size: 16px;
    line-height: 1.62;
  }
  .actions {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 27px;
    flex-shrink: 0;
  }
  .button {
    font-size: 13px;
    min-height: 48px;
    padding-inline: 23px;
    border-radius: 8px;
    box-shadow: inset 0 1px 0 #dce4ff08;
  }
  .button-primary {
    background: var(--blue);
    color: #06122a;
    border-color: #7992ff70;
    box-shadow:
      inset 0 1px 0 #c9daff55,
      0 8px 25px #375ff222;
  }
  .how-button {
    background: linear-gradient(145deg, #111e30aa, #08101dd9);
    color: #edf2ff;
    cursor: pointer;
    backdrop-filter: blur(12px);
  }
  .hero {
    position: relative;
    isolation: isolate;
    margin-top: -76px;
    padding-top: 76px;
    overflow: hidden;
    background: radial-gradient(ellipse at 55% 20%, #1e2f572b, transparent 60%);
  }
  .hero::before {
    content: "";
    position: absolute;
    inset: -100px 0 0;
    background:
      linear-gradient(115deg, transparent 25%, #597aff06 45%, transparent 63%),
      radial-gradient(ellipse at 80% 80%, #2956b917, transparent 50%);
    z-index: -1;
  }
  .hero-content {
    text-align: center;
    padding-top: 47px;
    padding-bottom: 20px;
  }
  .hero-content > p {
    max-width: 680px;
    margin: 24px auto 0;
    font-size: 18px;
    line-height: 1.65;
  }
  .hero-content .actions {
    justify-content: center;
  }
  .hero-tags {
    display: flex;
    justify-content: center;
    gap: 24px;
    flex-wrap: wrap;
    margin-top: 26px;
  }
  .hero-tags span {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 11px;
    color: #b5c7e4;
  }
  .hero-tags :global(svg) {
    color: #7b9aff;
  }
  .benefit-band {
    background: linear-gradient(180deg, #0a1320, #080f18);
    border-block: 1px solid #26385855;
  }
  .benefits {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    padding: 31px 0;
  }
  .benefits article {
    padding: 0 22px;
    border-right: 1px solid #26395880;
  }
  .benefits article:first-child {
    padding-left: 0;
  }
  .benefits article:last-child {
    border: 0;
  }
  .benefits :global(svg) {
    color: var(--blue);
    filter: drop-shadow(0 0 12px #547cff2b);
    margin-bottom: 12px;
    stroke-width: 1.7;
  }
  .benefits h3 {
    font-size: 16px;
    margin-bottom: 5px;
  }
  .benefits p {
    font-size: 13px;
    line-height: 1.5;
  }
  .section-compact {
    padding-block: 46px;
  }
  .section-heading-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 65px;
    align-items: center;
    margin-bottom: 27px;
  }
  .section-heading-row > p {
    max-width: 455px;
  }
  .impact-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }
  .impact-card {
    position: relative;
    isolation: isolate;
    padding: 25px 24px;
    border: 1px solid #5376a925;
    border-radius: 13px;
    background:
      radial-gradient(ellipse at 20% 0%, #35518620, transparent 65%),
      linear-gradient(135deg, #0e1a2a, #0c1522);
    box-shadow:
      inset 0 1px 0 #adc8ff07,
      0 18px 30px #0002;
    overflow: hidden;
    transition:
      transform 0.3s,
      border-color 0.3s,
      box-shadow 0.3s;
  }
  .impact-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 30% 0%, #587bfa18, transparent 62%);
    opacity: 0;
    transition: opacity 0.3s;
    z-index: -1;
  }
  .impact-card:hover {
    transform: translateY(-4px);
    border-color: #668ce855;
    box-shadow:
      inset 0 1px 0 #adc8ff10,
      0 20px 45px #0003;
  }
  .impact-card:hover::before {
    opacity: 1;
  }
  .impact-card :global(svg) {
    color: var(--blue);
    stroke-width: 1.7;
    filter: drop-shadow(0 0 12px #5273ff33);
    margin-bottom: 13px;
  }
  .impact-card h3 {
    margin-bottom: 7px;
  }
  .impact-card p {
    font-size: 14px;
    max-width: 290px;
  }
  .impact-card > strong {
    display: block;
    font-size: 38px;
    font-weight: 750;
    color: #93aaff;
    letter-spacing: -0.035em;
    margin-top: 20px;
  }
  .impact-card > strong span {
    font-size: 13px;
    font-weight: 500;
    color: #c2cee5;
    letter-spacing: 0;
  }
  .impact-card > small {
    font-size: 11px;
    color: #95a8c4;
    display: block;
    margin-top: 5px;
  }
  .fine-print {
    font-size: 12px;
    line-height: 1.7;
    color: #91a1bc;
    margin-top: 19px;
  }
  .fine-print a {
    color: #b1c6ff;
