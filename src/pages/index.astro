---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CodeWindow from "@/components/CodeWindow.astro";
import LanguageIcon from "@/components/LanguageIcon.astro";
import ContactOptions from "@/components/ContactOptions.astro";
import {
  ArrowRight,
  Github,
  Zap,
  Cpu,
  LockKeyhole,
  Puzzle,
  Globe,
  ChartNoAxesColumnIncreasing,
  FlaskConical,
  Settings,
  Box,
  Database,
  Code,
  Network,
  Theater,
  Bot,
} from "lucide-astro";
const base = import.meta.env.BASE_URL;
const repo = "https://github.com/moreveal/mimic";
const benchmark = `${base}benchmarks/`;
const codes = {
  python: {
    label: "Python",
    lang: "python",
    code: `from playwright.sync_api import sync_playwright

with sync_playwright() as p:
    browser = p.chromium.connect_over_cdp(
        "http://127.0.0.1:9222"
    )
    page = browser.contexts[0].new_page()
    page.goto("https://example.com/")

    # Extract data from the live DOM
    title = page.locator("h1").inner_text()
    print(title)
    browser.close()`,
  },
  node: {
    label: "Node.js",
    lang: "javascript",
    code: `import { chromium } from "playwright-core";

const browser = await chromium.connectOverCDP(
  "http://127.0.0.1:9222"
);
const page = await browser.contexts()[0].newPage();
page.goto("https://example.com/");

const links = await page.locator("a").evaluateAll(
  nodes => nodes.map(a => ({ text: a.textContent, url: a.href }))
);
console.log(links);
await browser.close();`,
  },
  cdp: {
    label: "Raw CDP",
    lang: "jsonc",
    code: `{
  "id": 1,
  "method": "Runtime.evaluate",
  "params": {
    "expression": "({ title: document.title, url: location.href })",
    "returnByValue": true
  }
}`,
  },
};
const features = [
  {
    icon: Zap,
    title: "Real browser behavior",
    text: "JavaScript, DOM, navigation and browser state. Measured against Chrome 152.",
  },
  {
    icon: Cpu,
    title: "Resource efficient",
    text: "Run independent Pages concurrently, without Chromium’s rendering pipeline.",
  },
  {
    icon: LockKeyhole,
    title: "Consistent observations",
    text: "Coherent browser profiles and observable state across your workflow.",
  },
  {
    icon: Puzzle,
    title: "Fits your workflow",
    text: "One standalone executable. Connect with the automation tools you already use.",
  },
];
const metrics = [
  {
    icon: Zap,
    value: "6.0×",
    title: "Higher static throughput",
    mimic: "108.67",
    chrome: "18.09",
    width: 17,
    unit: "sessions/s",
  },
  {
    icon: Cpu,
    value: "8.3×",
    title: "Less ready memory",
    mimic: "45.79",
    chrome: "379.54",
    width: 12,
    unit: "MiB RSS",
  },
  {
    icon: Database,
    value: "5.5×",
    title: "Less active memory",
    mimic: "748.11",
    chrome: "4,102.04",
    width: 18,
    unit: "MiB RSS · 50 Pages",
  },
];
const tools = [
  {
    icon: Theater,
    title: "Playwright",
    text: "Connect your existing scripts over CDP.",
  },
  {
    icon: Bot,
    title: "Puppeteer",
    text: "Use your familiar automation workflow.",
  },
  {
    icon: Code,
    title: "Chrome DevTools Protocol",
    text: "Control the supported browser surface.",
  },
  {
    icon: Network,
    title: "HTTP / HTTPS / SOCKS5",
    text: "Use your own proxy infrastructure.",
  },
];
const uses = [
  {
    icon: Globe,
    title: "Data extraction",
    text: "Read content from JavaScript-driven websites.",
  },
  {
    icon: ChartNoAxesColumnIncreasing,
    title: "Automation at scale",
    text: "Run concurrent Pages with less overhead.",
  },
  {
    icon: FlaskConical,
    title: "Testing & QA",
    text: "Check supported browser behavior in your workflow.",
  },
  {
    icon: Settings,
    title: "Web monitoring",
    text: "Track changes and collect website data.",
  },
  {
    icon: Box,
    title: "Custom tools",
    text: "Build browser automation into your product.",
  },
];
---

<BaseLayout
  title="Mimic — Lightweight Browser Automation Without Chromium"
  description="Reduce browser automation time and resource costs with Mimic, a lightweight runtime between HTTP clients and Chromium. JavaScript, browser state and CDP tooling."
>
  <section class="hero-scene">
    <img
      class="hero-art"
      src={`${base}images/mascot-hero.png`}
      alt="A blue one-eyed Mimic mascot holding a browser window in a softly lit studio"
      fetchpriority="high"
    />
    <div class="hero-shade"></div>
    <div class="container hero-copy">
      <span class="eyeline">A lightweight browser runtime</span>
      <h1>Same web.<br /><em>Less weight.</em></h1>
      <p>
        Mimic runs website JavaScript for automation and data extraction without
        Chromium’s rendering pipeline. Focus on your work, with less browser
        overhead.
      </p>
      <div class="actions">
        <a class="button button-primary" href={`${base}download/`}
          >Download Mimic <ArrowRight size={18} /></a
        ><a class="button" href={repo}><Github size={20} /> View on GitHub</a>
      </div>
      <div class="hero-tags">
        <span><Code size={14} /> Source available</span><span
          ><Zap size={14} /> Automation-first</span
        ><span><Box size={14} /> Runs without Chromium</span>
      </div>
    </div>
  </section>
  <section class="feature-strip" id="features">
    <div class="container feature-grid">
      {
        features.map(({ icon: Icon, title, text }) => (
          <article>
            <>
              <Icon size={35} />
              <div>
                <>
                  <h3>{title}</h3>
                  <p>{text}</p>
                </>
              </div>
            </>
          </article>
        ))
      }
    </div>
  </section>
  <div class="container content">
    <section class="automation" id="about">
      <div>
        <h2>Built for automation,<br />not screenshots.</h2><p>
          Mimic sits between an HTTP client and a full Chromium browser. Our
          goal is faster, lower-cost automation that keeps its meaning:
          executing JavaScript, maintaining page state and preserving the
          observations that browser fingerprints depend on.
        </p><div class="actions">
          <a class="button button-primary" href={`${base}docs/`}
            >Read the docs <ArrowRight size={17} /></a
          ><a class="button" href={`${base}examples/`}
            >See examples <Code size={16} /></a
          >
        </div>
      </div>
      <div class="example">
        <div class="example-tabs" role="tablist" aria-label="Automation client">
          {
            Object.keys(codes).map((key, index) => (
              <button
                id={`tab-${key}`}
                role="tab"
                type="button"
                data-tab={key}
                aria-controls={`panel-${key}`}
                aria-selected={index === 0}
                tabindex={index === 0 ? 0 : -1}
                class:list={{ active: index === 0 }}
              >
                <LanguageIcon language={key} />
                {codes[key as keyof typeof codes].label}
              </button>
            ))
          }
        </div>{
          Object.entries(codes).map(([key, code], index) => (
            <div
              id={`panel-${key}`}
              role="tabpanel"
              aria-labelledby={`tab-${key}`}
              hidden={index !== 0}
            >
              <CodeWindow showcase code={code.code} lang={code.lang} />
            </div>
          ))
        }
      </div>
    </section>
    <section id="benchmarks" class="section-block">
      <span class="eyeline">Benchmarks</span><div class="section-heading">
        <h2>Real measurements. Less overhead.</h2><a href={benchmark}
          >See benchmark details <ArrowRight size={16} /></a
        >
      </div><p class="section-intro">
        Measured against Chrome 152. Lower memory usage and higher throughput in
        the controlled static workload.
      </p><div class="metric-grid">
        {
          metrics.map(
            (
              { icon: Icon, value, title, mimic, chrome, width, unit },
              index,
            ) => (
              <article class="metric-card">
                <>
                  <div class="metric-title">
                    <>
                      <Icon size={40} />
                      <div>
                        <>
                          <strong>{value}</strong>
                          <h3>{title}</h3>
                        </>
                      </div>
                    </>
                  </div>
                  <div class="bar-row">
                    <>
                      <span>Mimic</span>
                      <div class="bar-track">
                        <i style={`width:${index === 0 ? 100 : width}%`} />
                      </div>
                      <small>{mimic}</small>
                    </>
                  </div>
                  <div class="bar-row">
                    <>
                      <span>Chrome</span>
                      <div class="bar-track">
                        <i
                          class="chrome-bar"
                          style={`width:${index === 0 ? width : 100}%`}
                        />
                      </div>
                      <small>{chrome}</small>
                    </>
                  </div>
                  <div class="metric-unit">{unit}</div>
                </>
              </article>
            ),
          )
        }
      </div><p class="benchmark-note">
        September 29, 2026 · Windows 11 · 50 static Pages for throughput and
        active memory.<br />Fixture- and machine-specific results; some
        workloads favor Chrome. <a href={benchmark}>Results & methodology →</a>
      </p>
    </section>
    <section class="section-block" id="compatibility">
      <span class="eyeline">Compatibility</span><h2>
        Works with your tools.
      </h2><p class="section-intro">
        Use Mimic with Playwright, Puppeteer or any CDP client. No special SDK
        required.
      </p><div class="tool-grid">
        {
          tools.map(({ icon: Icon, title, text }) => (
            <article class="small-card tool-card">
              <>
                <Icon size={39} />
                <div>
                  <>
                    <h3>{title}</h3>
                    <p>{text}</p>
                  </>
                </div>
              </>
            </article>
          ))
        }
      </div><p class="boundary-note">
        Public beta. Compatibility depends on your workload. Mimic does not
        produce screenshots or rendered pixels. <a
          href={`${base}docs/#compatibility`}>Check the supported surface →</a
        >
      </p>
    </section>
    <section class="section-block" id="use-cases">
      <span class="eyeline">Use cases</span><h2>For real-world workflows.</h2><p
        class="section-intro"
      >
        For data extraction, testing, monitoring and workflows that need browser
        logic with less overhead.
      </p><div class="use-grid">
        {
          uses.map(({ icon: Icon, title, text }) => (
            <article class="small-card">
              <>
                <Icon size={28} />
                <h3>{title}</h3>
                <p>{text}</p>
              </>
            </article>
          ))
        }
      </div>
    </section>
  </div>
  <section class="closing-banner">
    <img src={`${base}images/mascot-banner.png`} alt="" loading="lazy" /><div
      class="closing-copy"
    >
      <h3>Ready to build with Mimic?</h3><p>
        Source available. Standalone.<br />Built for real automation.
      </p><div class="actions">
        <a class="button button-primary" href={`${base}download/`}
          >Download Mimic <ArrowRight size={17} /></a
        ><a class="button" href={repo}><Github size={19} /> View on GitHub</a>
      </div>
    </div>
  </section>
  <section class="container integration-cta" id="contact">
    <div>
      <span class="eyeline">Integration support</span><h2>
        Bring your real workload.
      </h2><p>
        Need help integrating? We can help evaluate compatibility, compare
        resource usage and fit Mimic into your existing infrastructure.
      </p>
    </div>
    <div class="integration-actions">
      <ContactOptions />
    </div>
  </section>
</BaseLayout>
<script>
  const initializedTabs = new WeakSet<HTMLButtonElement>();
  function initializeTabs() {
    const tabs = [
      ...document.querySelectorAll<HTMLButtonElement>("[data-tab]"),
    ];
    function selectTab(tab: HTMLButtonElement) {
      tabs.forEach((item) => {
        const active = item === tab;
        item.classList.toggle("active", active);
        item.setAttribute("aria-selected", String(active));
        item.tabIndex = active ? 0 : -1;
        document
          .getElementById(`panel-${item.dataset.tab}`)
          ?.toggleAttribute("hidden", !active);
      });
    }
    tabs.forEach((tab) => {
      if (initializedTabs.has(tab)) return;
      initializedTabs.add(tab);
      tab.addEventListener("click", () => selectTab(tab));
      tab.addEventListener("keydown", (event) => {
        if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key))
          return;
        event.preventDefault();
        const index =
          event.key === "Home"
            ? 0
            : event.key === "End"
              ? tabs.length - 1
              : (tabs.indexOf(tab) +
                  (event.key === "ArrowRight" ? 1 : -1) +
                  tabs.length) %
                tabs.length;
        selectTab(tabs[index]);
        tabs[index].focus();
      });
    });
  }
  initializeTabs();
  document.addEventListener("astro:page-load", initializeTabs);
</script>

