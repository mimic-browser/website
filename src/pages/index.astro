---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CodeWindow from "@/components/CodeWindow.astro";
import {
  ArrowRight,
  ChartNoAxesColumnIncreasing,
  CircleDot,
  CircleX,
  Copy,
  Cpu,
  Download,
  Github,
  ImageOff,
  Layers3,
  Settings2,
  TrendingUp,
  Zap,
} from "lucide-astro";

const base = import.meta.env.BASE_URL;
const playwrightCode = `import { chromium } from "playwright-core";
const browser = await chromium.connectOverCDP(
  "http://127.0.0.1:9222"
);
try {
  const context = browser.contexts()[0];
  const page = await context.newPage();
  await page.goto("https://example.com/");
  console.log(await page.locator("h1").innerText());
} finally {
  await browser.close();
}`;
const puppeteerCode = `import puppeteer from "puppeteer-core";
const browser = await puppeteer.connect({
  browserURL: "http://127.0.0.1:9222",
  defaultViewport: null
});
try {
  const page = await browser.newPage();
  await page.goto("https://example.com/");
  console.log(await page.$eval("h1", el => el.textContent));
} finally {
  await browser.disconnect();
}`;
const windowsCommand = ".\\mimic.exe -listen 127.0.0.1:9222";
const linuxCommand = "./mimic -listen 127.0.0.1:9222";
---

<BaseLayout
  title="Mimic — Browser execution, without the browser"
  description="Run website JavaScript and automate Chrome-visible state through CDP, without embedding Chromium."
>
  <section class="hero container">
    <div class="hero-copy">
      <span class="status"
        ><span class="status-mark" aria-hidden="true"></span> Public beta · Chrome
        152 reference</span
      >
      <h1>Browser execution,<br />without the browser.</h1>
      <p>
        Run website JavaScript and automate Chrome-visible state through CDP,
        without embedding Chromium.
      </p>
      <div class="hero-actions">
        <a
          class="button button-primary"
          href="https://github.com/moreveal/mimic/releases/latest"
          ><Download size={17} strokeWidth={1.8} />Download Mimic</a
        >
        <a class="button" href={`${base}docs/`}
          >Read the docs <ArrowRight size={16} strokeWidth={1.8} /></a
        >
      </div>
      <a class="integration-link" href="#contact"
        >Need help integrating? Get in touch <ArrowRight size={15} /></a
      >
      <div class="hero-foot">
        <a href="https://github.com/moreveal/mimic"
          ><Github size={18} />Go to GitHub</a
        ><span></span><p>Lightweight. Observable. Source available.</p>
      </div>
    </div>
    <div
      class="hero-snippets"
      aria-label="Run Mimic and connect your automation"
    >
      <div class="connect-snippet">
        <div class="snippet-tabs" role="tablist" aria-label="Automation client">
          <button
            class="active"
            type="button"
            role="tab"
            id="tab-playwright"
            aria-controls="panel-playwright"
            aria-selected="true"
            data-tab="playwright">Playwright</button
          >
          <button
            type="button"
            role="tab"
            id="tab-puppeteer"
            aria-controls="panel-puppeteer"
            aria-selected="false"
            data-tab="puppeteer">Puppeteer</button
          >
        </div>
        <div
          id="panel-playwright"
          role="tabpanel"
          aria-labelledby="tab-playwright"
        >
          <CodeWindow title="playwright.mjs" code={playwrightCode} />
        </div>
        <div
          id="panel-puppeteer"
          role="tabpanel"
          aria-labelledby="tab-puppeteer"
          hidden
        >
          <CodeWindow title="puppeteer.mjs" code={puppeteerCode} />
        </div>
      </div>
      <div class="run-strip" aria-label="Start Mimic locally">
        <span class="run-label">Start Mimic</span>
        <div class="platform-options" aria-label="Operating system">
          <button
            type="button"
            class="active"
            data-platform="windows"
            aria-pressed="true">Windows</button
          >
          <button type="button" data-platform="linux" aria-pressed="false"
            >Linux</button
          >
        </div>
        <code
          class="run-command"
          data-windows={windowsCommand}
          data-linux={linuxCommand}>{windowsCommand}</code
        >
        <button
          class="run-copy"
          type="button"
          aria-label="Copy Windows command"
          data-copy={windowsCommand}
        >
          <Copy size={15} /><span class="copy-label">Copy</span>
        </button>
        <a class="run-guide" href={`${base}docs/#getting-started`}
          >Setup guide <ArrowRight size={14} /></a
        >
      </div>
    </div>
  </section>

  <section class="steps container" aria-labelledby="steps-title">
    <div class="section-label">
      <h2 id="steps-title">Start in three steps</h2><span></span>
    </div>
    <ol>
      <li>
        <span class="step-number">1</span><div>
          <strong>Download binary</strong><p>
            Get the latest release for your platform from GitHub.
          </p>
        </div><ArrowRight class="step-arrow" size={18} />
      </li>
      <li>
        <span class="step-number">2</span><div>
          <strong>Start local endpoint</strong><p>
            Run Mimic and start the CDP endpoint.
          </p>
        </div><ArrowRight class="step-arrow" size={18} />
      </li>
      <li>
        <span class="step-number">3</span><div>
          <strong>Connect Playwright or Puppeteer</strong><p>
            Use your existing automation code.
          </p>
        </div>
      </li>
    </ol>
  </section>

  <section
    class="metrics container"
    id="benchmarks"
    aria-labelledby="metrics-title"
  >
    <div class="metrics-heading">
      <h2 id="metrics-title">Measured performance</h2>
      <span>Controlled static fixture · September 29, 2026</span>
    </div>
    <div class="metric">
      <span class="metric-icon"><Cpu size={24} strokeWidth={1.8} /></span><div>
        <strong>8.3×</strong><span>less CDP-ready RSS</span><small
          >45.79 MiB vs 379.54 MiB</small
        >
      </div>
    </div>
    <div class="metric">
      <span class="metric-icon"
        ><ChartNoAxesColumnIncreasing size={24} strokeWidth={1.9} /></span
      ><div>
        <strong>5.5×</strong><span>less active RSS at 50 Pages</span><small
          >748.11 MiB vs 4,102.04 MiB</small
        >
      </div>
    </div>
    <div class="metric">
      <span class="metric-icon"
        ><Zap size={26} strokeWidth={1.8} fill="currentColor" /></span
      ><div>
        <strong>6.0×</strong><span>static-fixture throughput at 50 Pages</span
        ><small>108.67 vs 18.09 sessions/s</small>
      </div>
    </div>
    <p class="metric-note">
      Results from a controlled static workload; see the setup, measurements,
      and limitations. <a
        href="https://github.com/moreveal/mimic/blob/main/benchmark/runs/13-rss-20260929/public-summary.md"
        >Read methodology <ArrowRight size={14} /></a
      >
    </p>
  </section>

  <section class="details container" id="product">
    <div class="detail-column">
      <span class="kicker">Product</span>
      <h2>Built around observable behavior</h2>
      <p>
        Mimic executes website JavaScript and exposes Chrome-visible state
        through CDP. It focuses on the parts that matter for automation without
        embedding Chromium.
      </p>
      <div class="detail-list">
        <div>
          <span><CircleX size={20} strokeWidth={1.4} /></span><div>
            <strong>Compatible with existing tooling</strong><p>
              Use Playwright, Puppeteer, or another CDP client.
            </p>
          </div>
        </div>
        <div>
          <span><TrendingUp size={20} strokeWidth={1.4} /></span><div>
            <strong>Independent Pages</strong><p>
              Run multiple Pages, each with its own event loop.
            </p>
          </div>
        </div>
        <div>
          <span><CircleDot size={20} strokeWidth={1.4} /></span><div>
            <strong>One executable</strong><p>
              The release needs no Chrome, Go, or Rust installation.
            </p>
          </div>
        </div>
      </div>
    </div>
    <div class="detail-column">
      <span class="kicker">Compatibility</span>
      <h2>Know the boundaries</h2>
      <p>
        Mimic is a public beta. Check that the browser features your project
        uses are supported. Use a full browser when visual output matters.
      </p>
      <div class="boundary-panel">
        <div>
          <ImageOff size={22} strokeWidth={1.5} /><span
            ><strong>No screenshots or rendered pixels</strong><p>
              Mimic does not produce visual output.
            </p></span
          >
        </div>
        <div>
          <Settings2 size={22} strokeWidth={1.5} /><span
            ><strong>Some browser features are not supported</strong><p>
              Compatibility depends on your workflow.
            </p></span
          >
        </div>
        <div>
          <Layers3 size={22} strokeWidth={1.5} /><span
            ><strong>Trusted local clients only</strong><p>
              The CDP endpoint has no authentication.
            </p></span
          >
        </div>
        <a href={`${base}docs/#compatibility`}
          >Read the documentation <ArrowRight size={16} /></a
        >
      </div>
    </div>
  </section>
  <section
    class="closing container"
    id="contact"
    aria-labelledby="contact-title"
  >
