    );
    color: #05143a;
    font-size: 25px;
    font-weight: 750;
    border: 1px solid #b2ccffa0;
    box-shadow:
      inset 0 2px 3px #e2eeff50,
      inset 0 -5px 8px #1b44c975,
      0 6px 16px #203d8555,
      0 0 24px #5176ff25;
    margin-bottom: 20px;
  }
  .steps h3 {
    font-size: 14px;
    margin-bottom: 10px;
  }
  .steps p {
