  .behavior-band {
    position: relative;
    background:
      radial-gradient(ellipse at 80% 0%, #18396817, transparent 70%), #070e17;
    border-block: 1px solid #24375455;
  }
  .capabilities {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .capabilities article {
    display: flex;
    gap: 15px;
    padding: 19px 0;
  }
  .capabilities :global(svg) {
    width: 34px;
    height: 34px;
    color: var(--blue);
    filter: drop-shadow(0 0 11px #6585ff22);
    flex: none;
    stroke-width: 1.8;
  }
  .capabilities h3 {
    font-size: 15px;
    margin-bottom: 7px;
  }
  .capabilities p {
    font-size: 13px;
    line-height: 1.55;
  }
  .optimize-section {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 70px;
    align-items: center;
