---
import ArticleLayout from "@/layouts/ArticleLayout.astro";
import license from "../../LICENSE.md?raw";
import { marked } from "marked";
const rendered = await marked.parse(license);
---

<ArticleLayout
  title="License"
  eyebrow="Project"
  icon="license"
  description="Mimic’s source-available license and third-party notices."
  ><div set:html={rendered} /></ArticleLayout
>
