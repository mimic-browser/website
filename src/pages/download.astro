---
import ArticleLayout from "@/layouts/ArticleLayout.astro";
import CodeWindow from "@/components/CodeWindow.astro";
import PlatformIcon from "@/components/PlatformIcon.astro";
import {
  Download,
  Cable,
  MessagesSquare,
  BookOpen,
  Code2,
  ShieldCheck,
  Scale,
} from "lucide-astro";
import release from "../../public/release-cache.json";
const base = import.meta.env.BASE_URL;
const windows = release.assets.find((asset) =>
  asset.name.endsWith("windows-amd64.zip"),
);
const linux = release.assets.find((asset) =>
  asset.name.endsWith("linux-amd64.tar.gz"),
);
const sums = release.assets.find((asset) => asset.name === "SHA256SUMS");
---

<ArticleLayout
  title="Download Mimic"
  eyebrow="Get started"
  icon="download"
  description="One standalone executable for Windows and Linux amd64. No Chromium, Go or Rust installation required."
>
  <p class="release-status">
    Latest stable beta: <strong data-release-version>{release.tag_name}</strong
    >{" "}
    <span data-release-status></span>
  </p>
  <div class="download-grid">
    <section>
      <h2 class="platform-heading">
        <PlatformIcon platform="windows" />Windows
      </h2><p>Windows x64. Extract the ZIP, then run Mimic.</p><a
        class="button button-primary"
        data-release-asset="windows-amd64.zip"
        href={windows?.browser_download_url}
        ><Download size={18} />Download for Windows</a
      ><CodeWindow
        title="PowerShell"
        lang="powershell"
        code={".\\mimic.exe -listen 127.0.0.1:9222"}
      />
    </section>
    <section>
      <h2 class="platform-heading"><PlatformIcon platform="linux" />Linux</h2><p
      >
        Linux amd64. Ubuntu 24.04+ with glibc 2.39+ and libgcc_s.
      </p><a
        class="button button-primary"
        data-release-asset="linux-amd64.tar.gz"
        href={linux?.browser_download_url}
        ><Download size={18} />Download for Linux</a
      ><CodeWindow
        title="Shell"
        lang="bash"
        code={"./mimic -listen 127.0.0.1:9222"}
      />
    </section>
  </div>
  <p class="download-details">
    <a data-release-asset="SHA256SUMS" href={sums?.browser_download_url}
      ><ShieldCheck size={17} />Download checksums</a
    >{" "}
    <a href={`${base}license/`}><Scale size={17} />License</a>
  </p>
  <h2 class="icon-heading"><Cable size={26} />Connect your automation</h2><p>
    The local CDP endpoint is ready at <code>http://127.0.0.1:9222</code>. Keep
    it accessible only to trusted local clients.
  </p><p class="page-actions">
    <a class="button button-primary" href={`${base}examples/`}
      ><Code2 size={18} />Try an example →</a
    >{" "}
    <a class="button" href={`${base}docs/`}
      ><BookOpen size={18} />Read the docs →</a
    >
  </p>
  <h2 class="icon-heading">
    <MessagesSquare size={26} />Need help integrating?
  </h2><p>
    Bring your workload. We can help evaluate compatibility and integrate Mimic
    into your infrastructure. <a href="mailto:slava@mimic.boo"
      >Email slava@mimic.boo</a
    >{" "}
    or <a href={`${base}#contact`}>choose Telegram or Discord</a>.
  </p>
</ArticleLayout>
<style>
  .platform-heading,
  .icon-heading {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .icon-heading :global(svg) {
    color: var(--blue);
    flex: none;
  }
  .download-details {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
  }
  .download-details a {
    display: inline-flex;
    gap: 8px;
    align-items: center;
  }
  .download-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }
  .download-grid section {
    min-width: 0;
  }
  .download-grid :global(.code-window) {
    margin-top: 22px;
  }
  .release-status {
    font-size: 16px;
  }
  @media (max-width: 760px) {
    .download-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
