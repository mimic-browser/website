---
import ArticleLayout from "@/layouts/ArticleLayout.astro";
import CodeWindow from "@/components/CodeWindow.astro";
import PlatformIcon from "@/components/PlatformIcon.astro";
import {
  Download,
  Cable,
  MessagesSquare,
  BookOpen,
  Code2,
  ShieldCheck,
  Scale,
} from "lucide-astro";
import { currentRelease, release } from "@/lib/release";
const base = import.meta.env.BASE_URL;
const { windows, linux, checksums: sums } = currentRelease;
---

<ArticleLayout
  title="Download Mimic"
  eyebrow="Get started"
  icon="download"
  compactHeader
  description="One standalone executable for Windows and Linux amd64. No Chromium, Go or Rust installation required."
>
  <p class="release-status">
    Current release:{" "}
    <strong data-release-version>{release.tag_name}</strong>{" "}
  </p>
  <div class="download-grid">
    <section>
      <h2 class="platform-heading">
        <PlatformIcon platform="windows" />
        Windows
      </h2>
      <p>Windows x64. Extract the ZIP, then run Mimic.</p>
      <a
        class="button button-primary"
        data-release-asset="windows-amd64.zip"
        href={windows.browser_download_url}
      >
        <Download size={18} />
        Download for Windows
      </a>
      <CodeWindow
        title="PowerShell"
        lang="powershell"
        code={".\\mimic.exe --browser-mode headless --listen 127.0.0.1:9222"}
      />
    </section>
    <section>
      <h2 class="platform-heading">
        <PlatformIcon platform="linux" />
        Linux
      </h2>
      <p>Linux x86_64 · glibc 2.39+ · libgcc_s. Tested on Ubuntu 24.04.</p>
      <a
        class="button button-primary"
        data-release-asset="linux-amd64.tar.gz"
        href={linux.browser_download_url}
      >
        <Download size={18} />
        Download for Linux
      </a>
      <CodeWindow
        title="Shell"
        lang="bash"
        code={"./mimic --browser-mode headless --listen 127.0.0.1:9222"}
      />
    </section>
  </div>
  <p class="download-details">
    <a data-release-asset="SHA256SUMS" href={sums.browser_download_url}>
      <ShieldCheck size={17} />
      Download checksums
    </a>{" "}
    <a href={`${base}license/`}>
      <Scale size={17} />
      License
    </a>
  </p>
  <h2 class="icon-heading">
    <Cable size={26} />
    Connect your automation
  </h2>
  <p>
    Once Mimic is running, connect your browser client to{" "}
    <code>http://127.0.0.1:9222</code>. Keep it accessible only to trusted local
    clients.
  </p>
  <p>
    Prefer automatic setup? The <a href={`${base}sdk/`}>Mimic SDK</a> can
    download, launch and manage the runtime for you.
  </p>
  <p class="page-actions">
    <a class="button button-primary" href={`${base}docs/connect/#playwright`}>
      <Code2 size={18} />
      Try an example →
    </a>{" "}
    <a class="button" href={`${base}docs/`}>
      <BookOpen size={18} />
      Read the docs →
    </a>
  </p>
  <h2 class="icon-heading">
    <MessagesSquare size={26} />
    Need help integrating?
  </h2>
  <p>
    Bring your workload. We can help evaluate compatibility and integrate Mimic
    into your infrastructure.{" "}
    <a href="mailto:slava@mimic.boo">Email slava@mimic.boo</a>.
  </p>
</ArticleLayout>
<style>
  .platform-heading,
  .icon-heading {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .icon-heading :global(svg) {
    color: var(--blue);
    flex: none;
  }
  .download-details {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
  }
  .download-details a {
    display: inline-flex;
    gap: 8px;
    align-items: center;
  }
  .download-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }
  .download-grid section {
    min-width: 0;
  }
  .download-grid :global(.code-window) {
    margin-top: 22px;
  }
  .release-status {
    font-size: 16px;
    margin: 0 0 18px;
  }
  .download-grid .platform-heading {
    margin-top: 16px;
  }
  a[data-release-asset]::after {
    content: none;
  }
  @media (max-width: 760px) {
    .download-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
