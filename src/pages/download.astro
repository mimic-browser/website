---
import ArticleLayout from "@/layouts/ArticleLayout.astro";
import CodeWindow from "@/components/CodeWindow.astro";
import release from "../../public/release-cache.json";
const base = import.meta.env.BASE_URL;
const windows = release.assets.find((asset) =>
  asset.name.endsWith("windows-amd64.zip"),
);
const linux = release.assets.find((asset) =>
  asset.name.endsWith("linux-amd64.tar.gz"),
);
const sums = release.assets.find((asset) => asset.name === "SHA256SUMS");
---

<ArticleLayout
  title="Download Mimic"
  eyebrow="Get started"
  description="One standalone executable for Windows and Linux amd64. No Chromium, Go or Rust installation required."
>
  <p class="release-status">
    Latest stable beta: <strong data-release-version>{release.tag_name}</strong>
    <span data-release-status></span>
  </p>
  <div class="download-grid">
    <section>
      <h2>Windows</h2><p>Windows x64. Extract the ZIP, then run Mimic.</p><a
        class="button button-primary"
        data-release-asset="windows-amd64.zip"
        href={windows?.browser_download_url}>Download for Windows</a
      ><CodeWindow
        title="PowerShell"
        lang="powershell"
        code={".\\mimic.exe -listen 127.0.0.1:9222"}
      />
    </section>
    <section>
      <h2>Linux</h2><p>
        Linux amd64. Ubuntu 24.04+ with glibc 2.39+ and libgcc_s.
      </p><a
        class="button button-primary"
        data-release-asset="linux-amd64.tar.gz"
        href={linux?.browser_download_url}>Download for Linux</a
      ><CodeWindow
        title="Shell"
        lang="bash"
        code={"./mimic -listen 127.0.0.1:9222"}
      />
    </section>
  </div>
  <p>
    <a data-release-asset="SHA256SUMS" href={sums?.browser_download_url}
      >Download checksums</a
    > · <a href={`${base}license/`}>License</a>
  </p>
  <h2>Connect your automation</h2><p>
    The local CDP endpoint is ready at <code>http://127.0.0.1:9222</code>. Keep
    it accessible only to trusted local clients.
  </p><p class="page-actions">
    <a class="button button-primary" href={`${base}examples/`}
      >Try an example →</a
    >
    <a class="button" href={`${base}docs/`}>Read the docs →</a>
  </p>
  <h2>Need help integrating?</h2><p>
    Bring your workload. We can help evaluate compatibility and integrate Mimic
    into your infrastructure. <a href="https://t.me/moreveal"
      >Talk to @moreveal on Telegram</a
    >.
  </p>
</ArticleLayout>
<style>
  .download-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }
  .download-grid section {
    min-width: 0;
  }
  .download-grid :global(.code-window) {
    margin-top: 22px;
  }
  .release-status {
    font-size: 16px;
  }
  @media (max-width: 760px) {
    .download-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
