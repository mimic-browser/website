---
import DocsLayout from "../../../layouts/DocsLayout.astro";
import { marked, type Token } from "marked";
export async function getStaticPaths() {
  const pages = import.meta.glob("../../../content/optimize/*.md", {
    query: "?raw",
    import: "default",
    eager: true,
  });
  const order = [
    "index",
    "workloads",
    "replay",
    "profiles",
    "manual-policy",
    "safety",
    "troubleshooting",
    "benchmarks",
    "results",
  ];
  const entries = Object.entries(pages)
    .map(([path, source]) => ({
      name: path.split("/").pop()!.replace(/\.md$/, ""),
      source: String(source),
    }))
    .sort((a, b) => order.indexOf(a.name) - order.indexOf(b.name));
  const readingSequence = entries.map(({ name, source }) => ({
    title: source.split("\n")[0].replace(/^# /, ""),
    path: `docs/optimize/${name === "index" ? "" : name + "/"}`,
  }));
  return entries.map(({ name, source }) => {
    const lines = source.split("\n");
    const title = lines.shift()!.replace(/^# /, "");
    const body = lines
      .join("\n")
      .replace(
        /\]\(([a-z-]+)\.md(#[a-z0-9-]+)?\)/g,
        (_, slug, fragment = "") =>
          `](${import.meta.env.BASE_URL}docs/optimize/${slug === "index" ? "" : slug + "/"}${fragment})`,
      );
    return {
      params: { slug: name === "index" ? undefined : name },
      props: { title, body, readingSequence },
    };
  });
}
const { title, body, readingSequence } = Astro.props;
const base = import.meta.env.BASE_URL;
const related = [
  ["Optimize guide", "docs/optimize/"],
  ["Safety limits", "docs/optimize/safety/"],
  ["Troubleshooting", "docs/optimize/troubleshooting/"],
].filter(
  ([, path]) => !Astro.url.pathname.replace(/\/?$/, "/").endsWith(`/${path}`),
);
const topics: [string, string][] = [];
function headingText(tokens: Token[]): string {
  return tokens
    .map((token) => {
      if ("tokens" in token && token.tokens) return headingText(token.tokens);
      return "text" in token ? token.text : token.raw;
    })
    .join("")
    .replace(/<[^>]*>/g, "");
}
const renderer = new marked.Renderer();
renderer.heading = function ({ tokens, depth }) {
  const text = this.parser.parseInline(tokens);
  const label = headingText(tokens);
  const id = label
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");
  if (depth === 2) topics.push([label, id]);
  return `<h${depth} id="${id}">${text}</h${depth}>`;
};
const html = await marked.parse(body, { renderer });
---

<DocsLayout
  title={title}
  description="Train against your assertions, validate replay, and reuse the measured result."
  topics={topics}
  readingSequence={readingSequence}
>
  <nav class="related-guides" aria-label="Related optimization guides">
    <span>Related guides</span>
    <div>
      {related.map(([label, path], index) => (
        <>
          {index > 0 && <span aria-hidden="true"> · </span>}
          <a href={`${base}${path}`}>{label}</a>
        </>
      ))}
    </div>
  </nav>
  <div set:html={html} />
</DocsLayout>

<style>
  .related-guides {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 16px;
    margin: 0 0 24px;
    padding: 12px 15px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    font-size: 0.8rem;
  }
  .related-guides > span {
    color: var(--quiet);
    font-size: 0.72rem;
    font-weight: 650;
  }
  .related-guides > div {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 8px;
  }
  .related-guides a {
    text-decoration: none;
  }
  .related-guides a:hover {
    text-decoration: underline;
  }
  .related-guides div > span {
    color: var(--quiet);
  }
</style>
