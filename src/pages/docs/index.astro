---
import BaseLayout from "@/layouts/BaseLayout.astro";
import DocsHub from "@/components/DocsHub.astro";
import { releaseTag, releaseDocURL } from "@/lib/release";
---

<BaseLayout
  title="Documentation — Mimic"
  description="Find runnable demos, configuration guides and the Mimic API reference."
>
  <DocsHub />
  <footer class="docs-source container">
    <div>
      <span>Runtime reference</span>
      <strong data-release-version>{releaseTag}</strong>
    </div>
    <nav aria-label="Source guides">
      <a href={releaseDocURL("environment-profiles.md")}>
        Environment profile specification
      </a>
      <a href={releaseDocURL("media-device-profiles-design.md")}>
        Media device specification
      </a>
      <a href={releaseDocURL("camera.md")}>Capture support</a>
    </nav>
  </footer>
</BaseLayout>

<style>
  .docs-source {
    display: flex;
    gap: 32px;
    justify-content: space-between;
    align-items: start;
    border-top: 1px solid var(--line);
    padding-top: 28px;
    padding-bottom: 60px;
    color: var(--quiet);
    font-size: 0.82rem;
  }
  .docs-source div {
    display: flex;
    gap: 12px;
  }
  .docs-source strong {
    color: var(--blue-bright);
  }
  .docs-source nav {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 22px;
  }
  .docs-source a:hover {
    color: var(--text);
  }
  @media (max-width: 760px) {
    .docs-source {
      flex-direction: column;
      gap: 18px;
    }
  }
</style>
