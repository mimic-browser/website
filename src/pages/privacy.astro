---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Privacy — Mimic"
  description="How the Mimic website uses privacy-focused traffic analytics."
>
  <section class="privacy-intro container">
    <span class="eyebrow">Privacy</span><h1>
      A simple site. Minimal analytics.
    </h1><p>
      Here is what this website collects and where external links take you.
    </p>
  </section>
  <div class="privacy-content container">
    <article class="prose">
      <h2>Website analytics</h2><p>
        We use Cloudflare Web Analytics to understand aggregate visits and
        improve the site and documentation. It reports page views, referring
        sites, browser type, and approximate country. We do not use analytics
        cookies, user accounts, ad trackers, or cross-site tracking.
      </p>
      <h2>Information you share</h2><p>
        This site does not ask for your name, email address, credentials,
        automation data, or Mimic profile files. Please do not put secrets,
        cookies, tokens, or private customer data in public GitHub issues.
      </p>
      <h2>External services</h2><p>
        Download files, source code and issues are hosted by GitHub. Email opens
        your chosen mail application. Those services have their own privacy terms.
      </p>
      <h2>Questions</h2><p>
        Email <a href="mailto:slava@mimic.boo">slava@mimic.boo</a>.
      </p>
    </article>
  </div>
</BaseLayout>

<style>
  .privacy-intro {
    padding-top: 75px;
    padding-bottom: 52px;
  }
  .privacy-intro h1 {
    max-width: 820px;
    margin: 16px 0 12px;
    font-size: clamp(2.7rem, 5vw, 4.3rem);
    line-height: 1.1;
    letter-spacing: -0.055em;
  }
  .privacy-intro p {
    margin: 0;
    color: var(--muted);
    font-size: 1.1rem;
  }
  .privacy-content {
    padding-top: 25px;
    padding-bottom: 110px;
    border-top: 1px solid var(--line);
  }
  .privacy-content article {
    max-width: 790px;
  }
  .privacy-content h2:first-child {
    border: 0;
    margin-top: 15px;
  }
  @media (max-width: 760px) {
    .privacy-intro {
      padding-top: 40px;
      padding-bottom: 35px;
    }
  }

  .privacy-intro h1 {
    font-weight: 800;
    letter-spacing: -0.045em;
  }
  .privacy-content article {
    max-width: 1080px;
    font-size: 17px;
    line-height: 1.75;
  }
  @media (min-width: 1500px) {
    .privacy-intro h1 {
      max-width: 1100px;
      font-size: 72px;
    }
    .privacy-intro p {
      font-size: 21px;
    }
    .privacy-content article {
      font-size: 19px;
      max-width: 1200px;
    }
  }
</style>
