---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ArrowUpRight, ArrowRight, Gauge, Code2 } from "lucide-astro";
import results from "../../public/benchmarks-results.json";
const base = import.meta.env.BASE_URL;
const report =
  "https://github.com/mimic-browser/runtime/blob/main/benchmark/runs/14-memory-20261010/public-summary.md";
const batch = results.density.find(
  (r) => r.workload === "static" && r.n === 50,
)!;
const speed = batch.throughput_pages_s! / batch.chrome_throughput_pages_s!;
const saving = batch.september_chrome_rss_mib! / batch.active_rss_mib!;
const fmt = (v: number | null | undefined) => (v == null ? "—" : v.toFixed(2));
const optimize = results.optimize;
---

<BaseLayout
  title="Benchmarks — Memory, processing speed and Optimize — Mimic"
  description="5.64× less active memory, 7.45× more pages per second at 50-page concurrency, and 98.1% fewer HTTP body bytes with Optimize in separate controlled workloads."
>
  <div class="container benchmarks">
    <section class="bench-hero">
      <span class="kicker"><Gauge size={16} /> BENCHMARKS</span>
      <h1>Less memory. More work.</h1>
      <div class="intro-row">
        <p class="intro">
          Memory under load, processing speed at equal Page concurrency and
          network acquisition with Optimize. Controlled workloads with explicit
          correctness checks.
        </p><div class="cta-options">
          <a class="download-button" href={`${base}sdk/`}
            ><Code2 size={18} /> Get started with SDK</a
          ><a class="standalone-link" href={`${base}download/`}
            >Standalone download <ArrowRight size={16} /></a>
        </div>
      </div>
      <div class="benchmark-meta">
        <span
          >October 10, 2026 · Chrome 152 · Windows 11 · i7-14700KF · 32 GiB RAM</span
        ><a class="text-link" href={report}
          >Methodology <ArrowUpRight size={20} /></a>
      </div>
    </section>
    <section class="highlights" aria-label="Benchmark highlights">
      <article class="stat">
        <span class="stat-label">ACTIVE MEMORY</span><strong
          >{saving.toFixed(2)}<span>×</span></strong
        ><h2>Less memory under load.</h2><p>
          727.78 vs. 4,102.04 MiB process-tree RSS with 50 active static Pages.
        </p>
      </article>
      <article class="stat">
        <span class="stat-label">PROCESSING SPEED</span><strong
          >{speed.toFixed(2)}<span>×</span></strong
        ><h2>More Pages per second.</h2><p>
          164.62 vs. 22.11 Pages/s at the same 50-Page concurrency, including
          create and teardown.
        </p>
      </article>
      <article class="stat">
        <span class="stat-label">OPTIMIZE ACQUISITION</span><strong
          >{optimize.reduction_percent.toFixed(1)}<span>%</span></strong
        ><h2>Acquire fewer bytes.</h2><p>
          284,591 → 5,276 HTTP body bytes for Books extraction with Optimize on
          versus off. Separate workload; 5/5 passes.
        </p>
      </article>
    </section>
    <section class="comparison section-block">
      <div class="section-heading">
        <div>
          <span class="kicker">SAME NUMBER OF PAGES</span><h2>
            50 Pages. Compare the work.
          </h2>
        </div><p>
          250/250 measured static batch attempts passed for each runtime. These
          runs are separate observations, with a small instrumentation-boundary
          difference recorded below.
        </p>
      </div>
      <div class="chart-grid">
        <article class="chart">
          <div class="chart-title">
            <h3>Active memory</h3><span>Lower is better</span>
          </div><div class="bar-row">
            <div class="bar-label"><b>Mimic</b><span>727.78 MiB</span></div><div
              class="track"
            >
              <div class="fill mimic" style="width:17.74%"></div>
            </div>
          </div><div class="bar-row">
            <div class="bar-label">
              <b>Chrome 152</b><span>4,102.04 MiB</span>
            </div><div class="track">
              <div class="fill chrome" style="width:100%"></div>
            </div>
          </div>
        </article>
        <article class="chart">
          <div class="chart-title">
            <h3>Batch processing</h3><span>Higher is better</span>
          </div><div class="bar-row">
            <div class="bar-label">
              <b>Mimic</b><span>164.62 Pages/s</span>
            </div><div class="track">
              <div class="fill mimic" style="width:100%"></div>
            </div>
          </div><div class="bar-row">
            <div class="bar-label">
              <b>Chrome 152</b><span>22.11 Pages/s</span>
            </div><div class="track">
              <div class="fill chrome" style="width:13.43%"></div>
            </div>
          </div>
        </article>
      </div>
      <p class="footnote">
        CPU cost: 69.94 vs. 133.38 ms per Page. Mimic batch latency p50/p95:
        161.33 / 197.39 ms; Chrome: 1,853.23 / 2,382.80 ms. Batch speed does not
        imply faster single-Page completion.
      </p>
    </section>
    <section class="section-block details">
      <h2>Concurrency, memory and CPU</h2><p>
        Measured active RSS, batch throughput, CPU per Page and RSS 250 ms after
        teardown. A failed series is excluded from successful comparisons. An
        absent Chrome value means no successful matching reference is available.
      </p><div class="table-scroll">
        <table>
          <thead
            ><tr
              ><th>Workload</th><th>Pages</th><th>Mimic / Chrome RSS MiB</th><th
                >Mimic / Chrome Pages/s</th
              ><th>Mimic / Chrome CPU ms/Page</th><th>Mimic recovery RSS MiB</th
              ><th>Valid / attempts</th></tr
            ></thead
          ><tbody
            >{
              results.density.map((r) => (
                <tr>
                  <>
                    <td>{r.workload}</td>
                    <td>{r.n}</td>
                    <td>
                      {fmt(r.active_rss_mib)} /{" "}
                      {fmt(r.september_chrome_rss_mib)}
                    </td>
                    <td>
                      {fmt(r.throughput_pages_s)} /{" "}
                      {fmt(r.chrome_throughput_pages_s)}
                    </td>
                    <td>
                      {fmt(r.cpu_per_page_ms)} / {fmt(r.chrome_cpu_per_page_ms)}
                    </td>
                    <td>{fmt(r.recovery_rss_mib)}</td>
                    <td>
                      {r.valid} / {r.attempts}
                      {r.failure ? " · failed" : ""}
                    </td>
                  </>
                </tr>
              ))
            }</tbody>
        </table>
      </div><p class="footnote">
        RSS sums process working sets and can count shared pages more than once.
        Recovery is a short observation, not proof of leak absence or an
        absolute capacity limit.
      </p>
    </section>
    <section class="section-block details">
      <h2>Single-Page latency and CPU</h2><p>
        20 measured warm attempts per workload and runtime, one warmup excluded.
        These tables include workloads where Mimic completes more slowly. CPU
        covers Page creation through teardown; completion spans navigation
        through the exact workload result.
      </p><div class="table-scroll">
        <table>
          <thead
            ><tr
              ><th>Workload</th><th>Mimic p50 / p95 ms</th><th
                >Chrome p50 / p95 ms</th
              ><th>Mimic / Chrome CPU ms/Page</th></tr
            ></thead
          ><tbody
            >{
              results.single.map((r) => (
                <tr>
                  <>
                    <td>{r.workload}</td>
                    <td>
                      {fmt(r.completion_p50_ms)} / {fmt(r.completion_p95_ms)}
                    </td>
                    <td>
                      {fmt(r.chrome_completion_p50_ms)} /{" "}
                      {fmt(r.chrome_completion_p95_ms)}
                    </td>
                    <td>
                      {fmt(r.cpu_per_page_ms)} / {fmt(r.chrome_cpu_per_page_ms)}
                    </td>
                  </>
                </tr>
              ))
            }</tbody>
        </table>
      </div>
    </section>
    <section class="section-block details">
      <h2>Optimize on versus off</h2><p>
        Books SSR extraction: <strong
          >98.1% fewer acquired HTTP body bytes</strong
        >, 284,591 → 5,276; transport responses 29 → 1. Both Mimic Default and
        installed Auto passed 5/5 matched local trials. Manual tied Auto.
        Training and validation took 27.1 seconds.
      </p><p>
        Separate recorded workload from October 5. Encoded acquired bodies are
        not physical wire traffic. One captured state does not establish savings
        on other sites or future states.
      </p><a class="text-link" href={`${base}docs/optimize/results/`}
        >Optimize results and limits <ArrowUpRight size={18} /></a>
    </section>
    <section class="evidence section-block">
      <div>
        <h2>Measurement boundaries and failures</h2><p>
          The final Mimic executable passed 120/120 warm single-Page attempts.
          Static and CPU completed 100 Pages; React completed 50 Pages.
          React-100 failed in its final wave with a native access violation and
          is excluded from successful comparisons: 2,810/2,910 density attempts
          valid.
        </p><p>
          Active-memory comparisons reuse the frozen Chrome reference;
          timing/CPU use the saved October 10 Chrome capture. Both runners use
          the same fixture, frozen execute, navigation barrier and 50 ms
          completion polling. Candidate wave timing includes the initial
          accounting snapshot and excludes the final one; reference timing does
          the reverse. Guards differ (120 vs. 180 seconds) and were not reached.
          Runs are unpaired; background load can vary. CPU is process-tree
          user+kernel time; latency quantiles use linear interpolation.
        </p><p>
          Mimic does not render pixels. These fixtures do not establish general
          website compatibility or a universal speedup. Exact binary, fixture,
          adapter and capture hashes are available in the methodology and data.
        </p>
      </div><div class="evidence-links">
        <a href={report}
          ><span
            >Report &amp; methodology<small
              >Measurement scope, provenance and limits</small
            ></span
          ><ArrowUpRight size={20} /></a
        ><a href={`${base}benchmarks-results.json`}
          ><span
            >Download current results<small>Workload measurements · JSON</small
            ></span
          ><ArrowRight size={20} /></a>
      </div>
    </section>
  </div>
</BaseLayout>
<style>
  .benchmarks {
    max-width: 1200px;
    padding-bottom: 70px;
  }
  .bench-hero {
    padding: 54px 0 30px;
  }
  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--blue-bright);
    font-size: 11px;
    font-weight: 650;
    letter-spacing: 0.1em;
  }
  h1 {
    font-size: clamp(32px, 4vw, 48px);
    line-height: 1.15;
    letter-spacing: -0.045em;
    margin: 15px 0 10px;
    font-weight: 600;
  }
  .intro {
    font-size: 16px;
    color: var(--muted);
    margin: 0;
  }
  .benchmark-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    margin-top: 22px;
    font-size: 11px;
    color: var(--quiet);
  }
  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--muted);
    font-size: 12px;
  }
  .text-link:hover {
    color: var(--blue-bright);
  }
  .highlights {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid var(--line);
    border-radius: 12px;
    background: linear-gradient(120deg, #19233b70, #11172340);
  }
  .stat {
    padding: 26px;
  }
  .stat + .stat {
    border-left: 1px solid var(--line);
  }
  .stat-label {
    color: var(--muted);
    font-size: 10px;
    letter-spacing: 0.1em;
    font-weight: 600;
  }
  .stat strong {
    display: block;
    font-size: clamp(52px, 6vw, 72px);
    line-height: 1.2;
    letter-spacing: -0.06em;
    font-weight: 550;
    margin: 12px 0;
    color: var(--blue-bright);
  }
  .stat strong span {
    font-size: 0.6em;
    margin-left: 4px;
  }
  .stat h2 {
    font-size: 16px;
    letter-spacing: -0.025em;
    margin: 0;
    font-weight: 600;
  }
  .stat p {
    font-size: 12px;
    color: var(--muted);
    margin: 8px 0 0;
  }
  .section-block {
    margin-top: 44px;
  }
  .section-heading {
    display: flex;
    justify-content: space-between;
    gap: 30px;
    align-items: end;
    margin-bottom: 22px;
  }
  .section-heading h2,
  .evidence h2 {
    font-size: clamp(23px, 2.7vw, 30px);
    line-height: 1.25;
    letter-spacing: -0.035em;
    margin: 10px 0 0;
    font-weight: 600;
  }
  .section-heading > p {
    max-width: 330px;
    font-size: 12px;
    color: var(--muted);
    margin: 0;
  }
  .chart-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  .chart {
    border: 1px solid var(--line);
    background: #11172360;
    padding: 26px;
    border-radius: 12px;
  }
  .chart-title,
  .bar-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  .chart-title {
    margin-bottom: 24px;
  }
  .chart-title h3 {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
  }
  .chart-title > span {
    font-size: 11px;
    color: var(--quiet);
  }
  .bar-row + .bar-row {
    margin-top: 20px;
  }
  .bar-label {
    font-size: 12px;
    margin-bottom: 9px;
  }
  .bar-label span {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .track {
    height: 16px;
    background: #20283a80;
    border-radius: 4px;
    overflow: hidden;
  }
  .fill {
    height: 100%;
    border-radius: 4px;
  }
  .mimic {
    background: linear-gradient(90deg, #718bff, #a9c1ff);
  }
  .chrome {
    background: #59667c;
  }
  .footnote {
    color: var(--quiet);
    font-size: 11px;
    line-height: 1.7;
  }
  .evidence {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
    border-top: 1px solid var(--line);
    padding-top: 30px;
  }
  .evidence p {
    font-size: 12px;
    line-height: 1.8;
    color: var(--muted);
  }
  .evidence-links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
    font-size: 13px;
  }
  .evidence-links a:hover {
    color: var(--blue-bright);
  }
  .evidence-links small {
    display: block;
    color: var(--quiet);
    font-size: 11px;
    margin-top: 4px;
  }
  @media (max-width: 760px) {
    .section-heading {
      display: block;
    }
    .section-heading > p {
      margin-top: 12px;
      max-width: 100%;
    }
    .stat {
      padding: 20px;
    }
    .evidence {
      gap: 24px;
    }
  }
  @media (max-width: 600px) {
    .benchmarks {
      width: calc(100% - 36px);
    }
    .bench-hero {
      padding-top: 36px;
    }
    .highlights,
    .chart-grid,
    .evidence {
      grid-template-columns: 1fr;
    }
    .stat + .stat {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    .stat strong {
      font-size: 56px;
    }
  }
  .intro-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
  }
  .download-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 13px 20px;
    border-radius: 8px;
    background: #93a6ff;
    color: #0b1220;
    font-size: 13px;
    font-weight: 700;
    flex-shrink: 0;
    box-shadow: 0 5px 22px #718bff15;
  }
  .download-button:hover {
    background: #b0bfff;
  }
  .benefits {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    padding: 30px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .benefits article > :global(svg) {
    color: var(--blue-bright);
  }
  .benefits h2 {
    font-size: 18px;
    letter-spacing: -0.03em;
    font-weight: 600;
    margin: 15px 0 9px;
  }
  .benefits p {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.8;
    margin: 0 0 18px;
  }
  .benefits p strong {
    color: var(--text);
    font-weight: 550;
  }
  .mini-memory {
    height: 10px;
    background: #59667c;
    border-radius: 3px;
    overflow: hidden;
  }
  .mini-memory > span {
    display: block;
    height: 100%;
    background: #a3b7ff;
  }
  .mini-caption {
    display: block;
    color: var(--quiet);
    font-size: 10px;
    margin-top: 7px;
  }
  .memory-difference {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .memory-difference strong {
    font-size: 28px;
    font-weight: 550;
    letter-spacing: -0.04em;
    color: var(--blue-bright);
    white-space: nowrap;
  }
  .memory-difference small {
    font-size: 13px;
    font-weight: 400;
  }
  .memory-difference > span {
    color: var(--quiet);
    font-size: 10px;
    max-width: 115px;
  }
  .download-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    background: linear-gradient(120deg, #24335480, #151e3080);
    border: 1px solid #344363;
    padding: 30px;
    margin-top: 40px;
    border-radius: 12px;
  }
  .download-strip h2 {
    font-size: 25px;
    letter-spacing: -0.035em;
    font-weight: 600;
    margin: 9px 0;
  }
  .download-strip p {
    font-size: 12px;
    color: var(--muted);
    margin: 0;
  }
  @media (max-width: 760px) {
    .benefits {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .benefits article + article {
      border-top: 1px solid var(--line);
      padding-top: 24px;
    }
    .mini-memory {
      max-width: 300px;
    }
  }
  @media (max-width: 600px) {
    .intro-row,
    .download-strip {
      flex-direction: column;
      align-items: flex-start;
    }
    .intro-row {
      gap: 18px;
    }
    .download-strip {
      padding: 24px;
    }
  }
  .cta-options {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }
  .standalone-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    color: var(--quiet);
  }
  .standalone-link:hover {
    color: var(--text);
  }
  @media (max-width: 600px) {
    .cta-options {
      align-items: flex-start;
    }
  }
</style>

<style>
  .table-scroll {
    overflow-x: auto;
  }
  .details table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  .details th,
  .details td {
    padding: 12px;
    border-bottom: 1px solid var(--border);
    text-align: left;
    white-space: nowrap;
  }
  .details p {
    color: var(--muted);
    line-height: 1.7;
    margin: 18px 0;
  }
</style>
