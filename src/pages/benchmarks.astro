---
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  ArrowUpRight,
  ArrowRight,
  Gauge,
  Check,
  Code2,
  Layers,
  Plug,
  Feather,
} from "lucide-astro";
import memory from "../../public/benchmarks-memory-results.json";
const base = import.meta.env.BASE_URL;
const report =
  "https://github.com/mimic-browser/runtime/blob/main/benchmark/runs/14-memory-20261010/public-summary.md";
const startupMemory = Math.round(
  (1 - memory.ready.final_mimic / memory.ready.september_chrome) * 100,
);
---

<BaseLayout
  title="Benchmarks — More automation. Less overhead. — Mimic"
  description="October memory checkpoint: 82% less active RSS and 89% less ready RSS than frozen Chrome 152 reference measurements."
>
  <div class="container benchmarks">
    <section class="bench-hero">
      <span class="kicker"><Gauge size={16} /> BENCHMARKS</span>
      <h1>Less memory. More pages.</h1>
      <div class="intro-row">
        <p class="intro">
          A lighter runtime for browser automation.<br />October memory
          measurements compared with frozen Chrome 152 reference observations on
          the same machine.
        </p><div class="cta-options">
          <a class="download-button" href={`${base}sdk/`}
            ><Code2 size={18} /> Get started with SDK</a
          ><a class="standalone-link" href={`${base}download/`}
            >Standalone download <ArrowRight size={16} /></a
          >
        </div>
      </div>
      <div class="benchmark-meta">
        <span
          >October 10, 2026 · Chrome 152 · Windows 11 · i7-14700KF · 32 GiB RAM</span
        ><a
          class="text-link"
          href={report}
          target="_blank"
          rel="noopener noreferrer">Methodology <ArrowUpRight size={20} /></a
        >
      </div>
    </section>

    <section class="highlights" aria-label="Benchmark highlights">
      <article class="stat">
        <span class="stat-label">READY MEMORY</span><strong
          >9.30<span>×</span></strong
        ><h2>Less memory before the first page.</h2><p>
          40.80 vs. 379.54 MiB ready process-tree RSS.
        </p>
      </article>
      <article class="stat">
        <span class="stat-label">LESS ACTIVE MEMORY</span><strong
          >82<span>%</span></strong
        ><h2>Leave room for more.</h2><p>
          728 vs. 4,102 MiB active process-tree RSS in the same 50-page
          benchmark.
        </p>
      </article>
      <article class="stat">
        <span class="stat-label">LESS STARTUP MEMORY</span><strong
          >{startupMemory}<span>%</span></strong
        ><h2>Start with a lighter footprint.</h2><p>
          41 vs. 380 MiB process-tree RSS when the runtime is ready.
        </p>
      </article>
    </section>

    <section class="comparison section-block">
      <div class="section-heading">
        <div>
          <span class="kicker">BUILT FOR PARALLEL WORK</span><h2>
            50 pages. A much smaller footprint.
          </h2>
        </div><p>
          Both runtimes completed all five measured waves with 100% success on
          the static DOM fixture.
        </p>
      </div>
      <div class="chart-grid">
        <article class="chart">
          <div class="chart-title">
            <h3>Ready memory</h3><span>Lower is better</span>
          </div><div class="bar-row">
            <div class="bar-label">
              <b>Mimic</b><span>40.80 MiB</span>
            </div><div class="track">
              <div class="fill mimic" style="width:10.75%"></div>
            </div>
          </div><div class="bar-row">
            <div class="bar-label">
              <b>Chrome 152</b><span>379.54 MiB</span>
            </div><div class="track">
              <div class="fill chrome" style="width:100%"></div>
            </div>
          </div>
        </article>
        <article class="chart">
          <div class="chart-title">
            <h3>Active memory</h3><span>Lower is better</span>
          </div><div class="bar-row">
            <div class="bar-label"><b>Mimic</b><span>728 MiB</span></div><div
              class="track"
            >
              <div class="fill mimic" style="width:17.74%"></div>
            </div>
          </div><div class="bar-row">
            <div class="bar-label">
              <b>Chrome 152</b><span>4,102 MiB</span>
            </div><div class="track">
              <div class="fill chrome" style="width:100%"></div>
            </div>
          </div>
        </article>
      </div>
      <p class="footnote">
        Completed 50-page static DOM series. RSS is summed across the process
        tree and can count shared memory more than once. This checkpoint
        measures memory only.
      </p>
    </section>

    <section
      class="benefits section-block"
      aria-label="What a lighter runtime means"
    >
      <article>
        <Feather size={23} /><h2>Light from the start.</h2><p>
          Ready at <strong>41 MiB</strong> of RSS, compared with 380 MiB for Chrome.
          A smaller starting footprint before your workload begins.
        </p><div class="mini-memory">
          <span style="width:10.75%"></span>
        </div><span class="mini-caption">Mimic / Chrome startup memory</span>
      </article>
      <article>
        <Layers size={23} /><h2>Room to run in parallel.</h2><p>
          <strong>50 active pages in 728 MiB.</strong> The same measured workload
          used 4,102 MiB in Chrome. Less memory tied up in browser processes.
        </p><div class="memory-difference">
          <strong>3.30 <small>GiB</small></strong><span
            >less active RSS in this comparison</span
          >
        </div>
      </article>
      <article>
        <Plug size={23} /><h2>Bring your automation.</h2><p>
          Connect Playwright or Puppeteer over CDP. Start with your existing
          workflow, then check compatibility and resource use on the pages you
          actually need.
        </p><a class="text-link" href={`${base}sdk/`}
          >See connection examples <ArrowRight size={20} /></a
        >
      </article>
    </section>

    <section class="evidence section-block">
      <div>
        <span class="kicker"><Check size={16} /> RESULTS YOU CAN INSPECT</span
        ><h2>The numbers, with context.</h2><p>
          October memory-only run: 120/120 single-page attempts passed. Static
          and CPU completed 100-page series; React completed 50 Pages. React-100
          failed in the final wave with a native access violation and is
          excluded from successful memory comparisons (2,810/2,910 density
          attempts valid). Chrome reference provenance is included in the
          methodology. Throughput and cold latency were not re-certified.
          Snapshot bytecode clearing traded approximately 7% static batch
          throughput for lower memory in a separate paired diagnostic. These
          fixtures do not establish general website compatibility or certify
          React at 100 Pages.
        </p><p>
          Mimic does not render pixels. Lower memory does not imply lower
          single-page latency. Measure your own workload.
        </p>
      </div>
      <div class="evidence-links">
        <a href={report} target="_blank" rel="noopener noreferrer"
          ><span
            >Full report & methodology<small
              >Setup, measurement boundaries and limitations</small
            ></span
          ><ArrowUpRight size={20} /></a
        ><a href={`${base}benchmarks-memory-results.json`}
          ><span
            >Download benchmark data<small
              >Results and build provenance · JSON</small
            ></span
          ><ArrowRight size={20} /></a
        ><a href={`${base}docs/optimize/results/`}
          ><span
            >Explore network savings<small
              >Separate measurements with Mimic Optimize</small
            ></span
          ><ArrowRight size={20} /></a
        >
      </div>
    </section>
    <section class="download-strip">
      <div>
        <span class="kicker">TRY YOUR OWN WORKLOAD</span><h2>
          See how light your automation can be.
        </h2><p>
          Start with the SDK and measure your own workflow. Prefer a separate
          runtime? Get the standalone download.
        </p>
      </div><div class="cta-options">
        <a class="download-button" href={`${base}sdk/`}
          ><Code2 size={18} /> Get started with SDK</a
        ><a class="standalone-link" href={`${base}download/`}
          >Standalone download <ArrowRight size={16} /></a
        >
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .benchmarks {
    max-width: 1200px;
    padding-bottom: 70px;
  }
  .bench-hero {
    padding: 54px 0 30px;
  }
  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--blue-bright);
    font-size: 11px;
    font-weight: 650;
    letter-spacing: 0.1em;
  }
  h1 {
    font-size: clamp(32px, 4vw, 48px);
    line-height: 1.15;
    letter-spacing: -0.045em;
    margin: 15px 0 10px;
    font-weight: 600;
  }
  .intro {
    font-size: 16px;
    color: var(--muted);
    margin: 0;
  }
  .benchmark-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    margin-top: 22px;
    font-size: 11px;
    color: var(--quiet);
  }
  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--muted);
    font-size: 12px;
  }
  .text-link:hover {
    color: var(--blue-bright);
  }
  .highlights {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid var(--line);
    border-radius: 12px;
    background: linear-gradient(120deg, #19233b70, #11172340);
  }
  .stat {
    padding: 26px;
  }
  .stat + .stat {
    border-left: 1px solid var(--line);
  }
  .stat-label {
    color: var(--muted);
    font-size: 10px;
    letter-spacing: 0.1em;
    font-weight: 600;
  }
  .stat strong {
    display: block;
    font-size: clamp(52px, 6vw, 72px);
    line-height: 1.2;
    letter-spacing: -0.06em;
    font-weight: 550;
    margin: 12px 0;
    color: var(--blue-bright);
  }
  .stat strong span {
    font-size: 0.6em;
    margin-left: 4px;
  }
  .stat h2 {
    font-size: 16px;
    letter-spacing: -0.025em;
    margin: 0;
    font-weight: 600;
  }
  .stat p {
    font-size: 12px;
    color: var(--muted);
    margin: 8px 0 0;
  }
  .section-block {
    margin-top: 44px;
  }
  .section-heading {
    display: flex;
    justify-content: space-between;
    gap: 30px;
    align-items: end;
    margin-bottom: 22px;
  }
  .section-heading h2,
  .evidence h2 {
    font-size: clamp(23px, 2.7vw, 30px);
    line-height: 1.25;
    letter-spacing: -0.035em;
    margin: 10px 0 0;
    font-weight: 600;
  }
  .section-heading > p {
    max-width: 330px;
    font-size: 12px;
    color: var(--muted);
    margin: 0;
  }
  .chart-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  .chart {
    border: 1px solid var(--line);
    background: #11172360;
    padding: 26px;
    border-radius: 12px;
  }
  .chart-title,
  .bar-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  .chart-title {
    margin-bottom: 24px;
  }
  .chart-title h3 {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
  }
  .chart-title > span {
    font-size: 11px;
    color: var(--quiet);
  }
  .bar-row + .bar-row {
    margin-top: 20px;
  }
  .bar-label {
    font-size: 12px;
    margin-bottom: 9px;
  }
  .bar-label span {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .track {
    height: 16px;
    background: #20283a80;
    border-radius: 4px;
    overflow: hidden;
  }
  .fill {
    height: 100%;
    border-radius: 4px;
  }
  .mimic {
    background: linear-gradient(90deg, #718bff, #a9c1ff);
  }
  .chrome {
    background: #59667c;
  }
  .footnote {
    color: var(--quiet);
    font-size: 11px;
    line-height: 1.7;
  }
  .evidence {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
    border-top: 1px solid var(--line);
    padding-top: 30px;
  }
  .evidence p {
    font-size: 12px;
    line-height: 1.8;
    color: var(--muted);
  }
  .evidence-links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
    font-size: 13px;
  }
  .evidence-links a:hover {
    color: var(--blue-bright);
  }
  .evidence-links small {
    display: block;
    color: var(--quiet);
    font-size: 11px;
    margin-top: 4px;
  }
  @media (max-width: 760px) {
    .section-heading {
      display: block;
    }
    .section-heading > p {
      margin-top: 12px;
      max-width: 100%;
    }
    .stat {
      padding: 20px;
    }
    .evidence {
      gap: 24px;
    }
  }
  @media (max-width: 600px) {
    .benchmarks {
      width: calc(100% - 36px);
    }
    .bench-hero {
      padding-top: 36px;
    }
    .highlights,
    .chart-grid,
    .evidence {
      grid-template-columns: 1fr;
    }
    .stat + .stat {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    .stat strong {
      font-size: 56px;
    }
  }
  .intro-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
  }
  .download-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 13px 20px;
    border-radius: 8px;
    background: #93a6ff;
    color: #0b1220;
    font-size: 13px;
    font-weight: 700;
    flex-shrink: 0;
    box-shadow: 0 5px 22px #718bff15;
  }
  .download-button:hover {
    background: #b0bfff;
  }
  .benefits {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    padding: 30px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .benefits article > :global(svg) {
    color: var(--blue-bright);
  }
  .benefits h2 {
    font-size: 18px;
    letter-spacing: -0.03em;
    font-weight: 600;
    margin: 15px 0 9px;
  }
  .benefits p {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.8;
    margin: 0 0 18px;
  }
  .benefits p strong {
    color: var(--text);
    font-weight: 550;
  }
  .mini-memory {
    height: 10px;
    background: #59667c;
    border-radius: 3px;
    overflow: hidden;
  }
  .mini-memory > span {
    display: block;
    height: 100%;
    background: #a3b7ff;
  }
  .mini-caption {
    display: block;
    color: var(--quiet);
    font-size: 10px;
    margin-top: 7px;
  }
  .memory-difference {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .memory-difference strong {
    font-size: 28px;
    font-weight: 550;
    letter-spacing: -0.04em;
    color: var(--blue-bright);
    white-space: nowrap;
  }
  .memory-difference small {
    font-size: 13px;
    font-weight: 400;
  }
  .memory-difference > span {
    color: var(--quiet);
    font-size: 10px;
    max-width: 115px;
  }
  .download-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    background: linear-gradient(120deg, #24335480, #151e3080);
    border: 1px solid #344363;
    padding: 30px;
    margin-top: 40px;
    border-radius: 12px;
  }
  .download-strip h2 {
    font-size: 25px;
    letter-spacing: -0.035em;
    font-weight: 600;
    margin: 9px 0;
  }
  .download-strip p {
    font-size: 12px;
    color: var(--muted);
    margin: 0;
  }
  @media (max-width: 760px) {
    .benefits {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .benefits article + article {
      border-top: 1px solid var(--line);
      padding-top: 24px;
    }
    .mini-memory {
      max-width: 300px;
    }
  }
  @media (max-width: 600px) {
    .intro-row,
    .download-strip {
      flex-direction: column;
      align-items: flex-start;
    }
    .intro-row {
      gap: 18px;
    }
    .download-strip {
      padding: 24px;
    }
  }
  .cta-options {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }
  .standalone-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    color: var(--quiet);
  }
  .standalone-link:hover {
    color: var(--text);
  }
  @media (max-width: 600px) {
    .cta-options {
      align-items: flex-start;
    }
  }
</style>
