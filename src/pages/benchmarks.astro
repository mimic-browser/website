---
import ArticleLayout from "@/layouts/ArticleLayout.astro";
import summary from "../../BENCHMARKS.md?raw";
import { marked } from "marked";
const base = import.meta.env.BASE_URL;
const rendered = (await marked.parse(summary)).replaceAll(
  'href="benchmarks/results.json"',
  `href="${base}benchmarks-results.json"`,
);
---

<ArticleLayout
  title="Browser automation benchmarks"
  eyebrow="Performance"
  description="Mimic and Chrome 152 compared on controlled workloads. Measurements, methodology and limits."
  ><div set:html={rendered} /></ArticleLayout
>
