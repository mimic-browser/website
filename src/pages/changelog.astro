---
import BaseLayout from "@/layouts/BaseLayout.astro";
import releaseNotes from "../../RELEASE_NOTES.md?raw";
import { marked } from "marked";
import { ArrowRight, Download } from "lucide-astro";
const base = import.meta.env.BASE_URL;
const rendered = await marked.parse(releaseNotes);
---

<BaseLayout
  title="Changelog — Mimic"
  description="What changed in each Mimic release."
>
  <section class="page-intro container">
    <div>
      <span class="eyebrow">Changelog</span><h1>What’s new in Mimic.</h1><p>
        Release notes for the public beta, with the details behind each update.
      </p>
    </div>
    <a class="button button-primary" href={`${base}download/`}
      ><Download size={18} />Download latest</a
    >
  </section>
  <div class="release-layout container">
    <article
      data-live-release-notes
      data-version="v0.1.9"
      class="release-notes prose"
      set:html={rendered}
    />
    <aside>
      <span>Latest release</span><strong data-release-version>v0.1.9</strong><a
        href="https://github.com/moreveal/mimic/releases"
        >All releases <ArrowRight size={16} /></a
      >
    </aside>
  </div>
</BaseLayout>

<style>
  .page-intro {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 28px;
    padding-top: 74px;
    padding-bottom: 54px;
  }
  .page-intro h1 {
    margin: 15px 0 10px;
    font-size: clamp(2.8rem, 5vw, 4.3rem);
    line-height: 1.08;
    letter-spacing: -0.055em;
  }
  .page-intro p {
    max-width: 620px;
    margin: 0;
    color: var(--muted);
    font-size: 1.1rem;
  }
  .page-intro .button {
    flex: none;
  }
  .release-layout {
    display: grid;
    grid-template-columns: minmax(0, 840px) 210px;
    justify-content: space-between;
    gap: 60px;
    padding-top: 48px;
    padding-bottom: 110px;
    border-top: 1px solid var(--line);
  }
  .release-notes {
    min-width: 0;
  }
  .release-notes :global(h1) {
    margin: 0 0 20px;
    font-size: 2rem;
  }
  .release-layout aside {
    position: sticky;
    top: 24px;
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .release-layout aside span {
    color: var(--quiet);
    font-size: 0.8rem;
  }
  .release-layout aside strong {
    font-size: 1.7rem;
  }
  .release-layout aside a {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--blue-bright);
    font-size: 0.85rem;
  }
  @media (max-width: 760px) {
    .page-intro {
      display: block;
      padding-top: 40px;
    }
    .page-intro .button {
      margin-top: 24px;
    }
    .release-layout {
      display: block;
      padding-top: 28px;
    }
    .release-layout aside {
      position: static;
      margin-top: 35px;
    }
  }

  .page-intro {
    padding-top: 65px;
    padding-bottom: 38px;
  }
  .page-intro h1 {
    font-weight: 800;
    letter-spacing: -0.045em;
  }
  .release-layout {
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: 64px;
    padding-top: 36px;
  }
  .release-notes {
    max-width: 1080px;
    font-size: 17px;
    line-height: 1.75;
  }
  .release-layout aside {
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: #111827;
  }
  .release-layout aside strong {
    color: var(--blue-bright);
    font-size: 28px;
  }
  @media (min-width: 1500px) {
    .release-notes {
      font-size: 19px;
      max-width: 1200px;
    }
    .page-intro h1 {
      font-size: 72px;
    }
    .page-intro p {
      font-size: 21px;
    }
    .release-layout {
      grid-template-columns: minmax(0, 1fr) 300px;
      gap: 90px;
    }
  }
  @media (max-width: 760px) {
    .release-layout {
      display: block;
    }
    .release-layout aside {
      position: static;
      margin-top: 32px;
    }
    .release-notes {
      font-size: 16px;
    }
  }
</style>
