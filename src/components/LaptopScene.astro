---
const base = import.meta.env.BASE_URL;
---

<div
  class="laptop-scene"
  aria-label="Mimic beside a laptop showing example.com"
>
  <div class="scene-canvas">
    <img
      src={base + "images/hero-laptop-desk.webp"}
      width="2075"
      height="758"
      alt="Mimic peeking around a laptop"
      fetchpriority="high"
    />
    <div class="browser-screen" aria-label="Example Domain page in a browser">
      <div class="tab-strip">
        <span class="window-dots"><i></i><i></i><i></i></span>
        <span class="tab">
          <svg
            class="favicon"
            viewBox="0 0 16 16"
            fill="none"
            aria-hidden="true"
            ><circle cx="8" cy="8" r="6.5" fill="#929aa5"></circle><path
              d="M1.8 7.6h3.1l1.1-2 2.2-.5 1.1-2.4M8.8 14.1l-.5-2.7-2-1.1-.1-2.2 2.3-1.2 1.8 1.3 2.5-.2"
              stroke="#343d4a"
              stroke-width="1.15"
              stroke-linejoin="round"></path></svg
          >
          <span>Example Domain</span>
          <svg
            class="tab-close"
            viewBox="0 0 16 16"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M4 4l8 8M12 4l-8 8"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"></path>
          </svg>
        </span>
        <svg class="new-tab" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M8 3v10M3 8h10"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"></path>
        </svg>
      </div>
      <div class="toolbar">
        <svg
          class="toolbar-icon"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M10.5 3.5 6 8l4.5 4.5"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <svg
          class="toolbar-icon muted"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M5.5 3.5 10 8l-4.5 4.5"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <svg class="reload" viewBox="0 0 16 16" fill="none" aria-hidden="true"
          ><path
            d="M13.3 7.2a5.4 5.4 0 1 0 .1 2.1M13.4 3.3v4h-4"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"></path></svg
        >
        <span class="address"
          ><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"
            ><rect
              x="3.5"
              y="6.8"
              width="9"
              height="7"
              rx="1.4"
              fill="currentColor"></rect><path
              d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2"
              stroke="currentColor"
              stroke-width="1.5"></path></svg
          >example.com</span
        >
        <svg
          class="menu-dots"
          viewBox="0 0 16 16"
          fill="currentColor"
          aria-hidden="true"
        >
          <circle cx="8" cy="3" r="1"></circle><circle cx="8" cy="8" r="1"
          ></circle><circle cx="8" cy="13" r="1"></circle>
        </svg>
      </div>
      <div class="page-content">
        <svg
          class="page-icon"
          viewBox="0 0 36 36"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M5 8.5 16 5l7 3 8-3v21l-8 3-7-3-11 3V8.5Z"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linejoin="round"></path>
          <path
            d="M16 5v21m7-18v21M10 12v11"
            stroke="currentColor"
            stroke-width="1.4"></path>
          <circle
            cx="25.7"
            cy="15"
            r="2"
            stroke="currentColor"
            stroke-width="1.1"></circle>
        </svg>
        <p>
          This domain is for use in documentation examples without needing
          permission. This is not a service; avoid relying on it for testing and
          monitoring purposes.
        </p>
      </div>
    </div>
  </div>
</div>

<style>
  .laptop-scene {
    position: relative;
    width: 100%;
    aspect-ratio: 2075 / 758;
    overflow: hidden;
  }
  .scene-canvas {
    --unit: 0.04819277cqw;
    position: absolute;
    inset: 0;
    container-type: inline-size;
  }
  img {
    display: block;
    width: 100%;
    height: 100%;
  }
  .browser-screen {
    position: absolute;
    left: calc(1055 * var(--unit));
    top: calc(201 * var(--unit));
    width: calc(594 * var(--unit));
    height: calc(369 * var(--unit));
    overflow: hidden;
    color: #d6dbe2;
    background: transparent;
    font-family: Arial, Helvetica, sans-serif;
    font-size: calc(12 * var(--unit));
    line-height: 1.35;
  }
  .tab-strip,
  .toolbar {
    display: flex;
    align-items: center;
  }
  .tab-strip {
    height: calc(35 * var(--unit));
    padding: 0 calc(13 * var(--unit));
    gap: calc(10 * var(--unit));
    background: #161d26;
  }
  .window-dots {
    display: flex;
    gap: calc(7 * var(--unit));
  }
  .window-dots i {
    width: calc(10 * var(--unit));
    height: calc(10 * var(--unit));
    border-radius: 50%;
    background: #f56a73;
  }
  .window-dots i:nth-child(2) {
    background: #eabe55;
  }
  .window-dots i:nth-child(3) {
    background: #59ba77;
  }
  .tab {
    display: flex;
    align-items: center;
    gap: calc(7 * var(--unit));
    width: calc(171 * var(--unit));
    height: calc(35 * var(--unit));
    align-self: end;
    padding: 0 calc(9 * var(--unit));
    border-radius: calc(9 * var(--unit)) calc(9 * var(--unit)) 0 0;
    background: #262b30;
    color: #e4e7eb;
    white-space: nowrap;
    font-size: calc(11 * var(--unit));
  }
  .favicon {
    width: calc(15 * var(--unit));
    height: calc(15 * var(--unit));
    flex: none;
  }
  .tab-close {
    margin-left: auto;
    color: #c7ccd2;
    width: calc(14 * var(--unit));
    height: calc(14 * var(--unit));
    flex: none;
  }
  .new-tab {
    color: #9aa5b1;
    width: calc(16 * var(--unit));
    height: calc(16 * var(--unit));
    flex: none;
  }
  .toolbar {
    height: calc(36 * var(--unit));
    gap: calc(13 * var(--unit));
    padding: 0 calc(14 * var(--unit));
    background: #202b38;
    color: #c7d0d9;
  }
  .toolbar-icon {
    width: calc(15 * var(--unit));
    height: calc(15 * var(--unit));
    flex: none;
  }
  .toolbar-icon.muted {
    color: #687581;
  }
  .reload {
    width: calc(15 * var(--unit));
    height: calc(15 * var(--unit));
    flex: none;
  }
  .address {
    display: flex;
    align-items: center;
    gap: calc(8 * var(--unit));
    flex: 1;
    height: calc(27 * var(--unit));
    padding: 0 calc(12 * var(--unit));
    border-radius: calc(18 * var(--unit));
    background: #182330;
    color: #e6e9ed;
  }
  .address svg {
    width: calc(12 * var(--unit));
    height: calc(12 * var(--unit));
    color: #bbc7cb;
  }
  .menu-dots {
    width: calc(15 * var(--unit));
    height: calc(15 * var(--unit));
    flex: none;
  }
  .page-content {
    display: flex;
    height: calc(298 * var(--unit));
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: calc(15 * var(--unit));
    padding: 0 calc(65 * var(--unit));
    background: transparent;
    text-align: center;
  }
  .page-icon {
    width: calc(31 * var(--unit));
    height: calc(31 * var(--unit));
    color: #adb6c1;
  }
  .page-content p {
    margin: 0;
    color: #c9d0d9;
    font-size: calc(16 * var(--unit));
    line-height: 1.5;
  }
  @media (max-width: 1300px) {
    .laptop-scene {
      aspect-ratio: 1.4;
    }
    .scene-canvas {
      width: 195.57%;
      left: -65%;
      height: 100%;
    }
  }
</style>
