---
import { Mail, Send, MessageCircle, ArrowUpRight } from "lucide-astro";
---

<nav class="contact-options" aria-label="Choose how to contact Slava">
  <a class="contact-option email" href="mailto:slava@mimic.boo">
    <Mail size={23} aria-hidden="true" />
    <span><strong>Email</strong><span>slava@mimic.boo</span></span>
  </a>
  <a class="contact-option" href="https://t.me/moreveal">
    <Send size={21} aria-hidden="true" />
    <span><strong>Telegram</strong><span>@moreveal</span></span>
    <ArrowUpRight class="external" size={17} aria-hidden="true" />
  </a>
  <a class="contact-option" href="https://discord.com/users/639562056915222573">
    <MessageCircle size={22} aria-hidden="true" />
    <span><strong>Discord</strong><span>moreveal</span></span>
    <ArrowUpRight class="external" size={17} aria-hidden="true" />
  </a>
</nav>
<style>
  .contact-options {
    display: grid;
    gap: 10px;
  }
  .contact-option {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 14px 18px;
    border: 1px solid var(--line-bright);
    border-radius: 10px;
    background: #111522;
    color: var(--text);
    text-decoration: none;
  }
  .contact-option:hover {
    background: #20263b;
    border-color: #718bff;
  }
  .contact-option:active {
    background: #181e30;
  }
  .contact-option > :global(svg) {
    flex: none;
    color: var(--blue-bright);
  }
  .contact-option > span {
    display: grid;
    gap: 3px;
  }
  strong {
    font-size: 15px;
    font-weight: 700;
  }
  .contact-option > span > span {
    font-size: 13px;
    color: var(--muted);
  }
  .external {
    margin-left: auto;
  }
  /* The destination arrow is explicit; suppress the general external-link suffix. */
  .contact-option::after {
    content: none !important;
  }
  .email {
    background: #718bff;
    border-color: #718bff;
    color: #080e25;
  }
  .email:hover {
    background: #859bff;
    border-color: #859bff;
  }
  .email:active {
    background: #617bef;
  }
  .email > :global(svg),
  .email > span > span {
    color: #080e25;
  }
  @media (min-width: 1500px) {
    .contact-option {
      padding: 17px 22px;
    }
    strong {
      font-size: 18px;
    }
    .contact-option > span > span {
      font-size: 16px;
    }
  }
</style>
