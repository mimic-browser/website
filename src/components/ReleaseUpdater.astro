<script>
  import bundledRelease from "../../public/release-cache.json";
  interface ReleaseAsset {
    name: string;
    browser_download_url: string;
  }
  interface Release {
    tag_name: string;
    published_at: string;
    body: string;
    assets: ReleaseAsset[];
  }
  const key = "mimic-latest-release";
  const ttl = 60 * 60 * 1000;
  const valid = (value: unknown): value is Release => {
    if (!value || typeof value !== "object") return false;
    const release = value as Release;
    return (
      typeof release.tag_name === "string" &&
      typeof release.published_at === "string" &&
      Number.isFinite(Date.parse(release.published_at)) &&
      typeof release.body === "string" &&
      Array.isArray(release.assets) &&
      release.assets.every(
        (asset) =>
          typeof asset.name === "string" &&
          typeof asset.browser_download_url === "string" &&
          asset.browser_download_url.startsWith(
            "https://github.com/mimic-browser/runtime/releases/download/",
          ),
      )
    );
  };
  function apply(release: Release) {
    document
      .querySelectorAll("[data-release-version]")
      .forEach((el) => (el.textContent = release.tag_name));
    document
      .querySelectorAll<HTMLAnchorElement>("[data-release-asset]")
      .forEach((link) => {
        const asset = release.assets.find((asset) =>
          asset.name.endsWith(link.dataset.releaseAsset || ""),
        );
        if (asset) link.href = asset.browser_download_url;
      });
    const notes = document.querySelector("[data-live-release-notes]");
    if (notes && notes.getAttribute("data-version") !== release.tag_name) {
      const fragment = document.createDocumentFragment();
      for (const line of release.body.split("\n")) {
        if (!line.trim()) continue;
        const heading = /^(#{1,3})\s+(.+)/.exec(line);
        const el = document.createElement(
          heading ? `h${Math.min(3, heading[1].length + 1)}` : "p",
        );
        el.textContent = heading ? heading[2] : line.replace(/^[-*]\s+/, "• ");
        fragment.append(el);
      }
      notes.replaceChildren(fragment);
      notes.setAttribute("data-version", release.tag_name);
    }
  }
  async function refresh() {
    if (!document.querySelector("[data-release-version], [data-release-asset]"))
      return;
    let cached: { saved: number; release: Release } | undefined;
    try {
      const value = JSON.parse(localStorage.getItem(key) || "null");
      if (
        value &&
        valid(value.release) &&
        typeof value.saved === "number" &&
        Date.parse(value.release.published_at) >=
          Date.parse(bundledRelease.published_at)
      )
        cached = value;
    } catch {
      /* Browser storage is optional. */
    }
    if (cached) {
      apply(cached.release);
      if (Date.now() - cached.saved < ttl) return;
    }
    try {
      const response = await fetch(
        "https://api.github.com/repos/mimic-browser/runtime/releases/latest",
        {
          headers: { Accept: "application/vnd.github+json" },
          signal: AbortSignal.timeout(8000),
        },
      );
      if (!response.ok)
        throw new Error(`GitHub release lookup: ${response.status}`);
      const release: unknown = await response.json();
      if (!valid(release))
        throw new Error("Unexpected GitHub release response");
      // A stale API/browser cache cannot downgrade the published static site.
      if (
        Date.parse(release.published_at) <
        Date.parse(bundledRelease.published_at)
      )
        return;
      apply(release);
      try {
        localStorage.setItem(
          key,
          JSON.stringify({ saved: Date.now(), release }),
        );
      } catch {
        /* Downloads still work when storage is disabled. */
      }
    } catch (error) {
      console.warn(
        "Mimic: using the saved release; latest release check unavailable.",
        error,
      );
      document
        .querySelectorAll("[data-release-status]")
        .forEach(
          (el) =>
            (el.textContent = "· Saved release; update check unavailable"),
        );
    }
  }
  document.addEventListener("astro:page-load", () => void refresh());
</script>
