---
interface Props {
  platform: "windows" | "linux";
}
const { platform } = Astro.props;
---

<span class="platform-icon" aria-hidden="true">
  {
    platform === "windows" ? (
      <svg viewBox="0 0 40 40" fill="none">
        <path
          d="M5 8.5 18 6.7V19H5V8.5Zm15-2.1L35 4v15H20V6.4ZM5 21h13v12.3L5 31.5V21Zm15 0h15v15l-15-2.4V21Z"
          fill="#83A3FF"
        />
      </svg>
    ) : (
      <svg viewBox="0 0 40 40" fill="none">
        <path
          d="M12 18c-2 4-5 7-5 11 0 3 3 3 5 1h16c2 2 5 2 5-1 0-4-3-7-5-11l-1-7c-1-5-4-7-7-7s-6 2-7 7l-1 7Z"
          fill="#202941"
          stroke="#8795C9"
          stroke-width="1.4"
        />
        <ellipse cx="20" cy="25" rx="8" ry="10" fill="#E4E9FF" />
        <ellipse cx="16.8" cy="12" rx="2.4" ry="3.3" fill="#F3F5FF" />
        <ellipse cx="23.2" cy="12" rx="2.4" ry="3.3" fill="#F3F5FF" />
        <ellipse cx="17.5" cy="12.5" rx="1" ry="1.6" fill="#131A2D" />
        <ellipse cx="22.5" cy="12.5" rx="1" ry="1.6" fill="#131A2D" />
        <path
          d="m15.5 16 4.5-2 4.5 2-4.5 3-4.5-3ZM7 34l7-3 4 5-10 1-1-3Zm26 0-7-3-4 5 10 1 1-3Z"
          fill="#EAB868"
        />
      </svg>
    )
  }
</span>
<style>
  .platform-icon {
    display: inline-flex;
    width: 54px;
    height: 54px;
    align-items: center;
    justify-content: center;
    flex: none;
    border: 1px solid #718bff30;
    border-radius: 14px;
    background: #718bff0c;
  }
  svg {
    width: 40px;
    height: 40px;
  }
</style>
