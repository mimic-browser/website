---
import Logo from "./Logo.astro";
import { ArrowRight } from "lucide-astro";
const base = import.meta.env.BASE_URL;
const links = [
  { label: "Features", href: `${base}#features` },
  { label: "Benchmarks", href: `${base}benchmarks/` },
  { label: "Examples", href: `${base}examples/` },
  { label: "Docs", href: `${base}docs/` },
  { label: "Blog", href: `${base}blog/` },
  { label: "About", href: `${base}about/` },
];
---

<header
  class="site-header"
  transition:name="site-header"
  transition:persist
  transition:animate="none"
>
  <div class="container nav-wrap">
    <a href={base} aria-label="Mimic home"><Logo /></a><button
      class="menu-button"
      type="button"
      aria-label="Open navigation"
      aria-expanded="false"
      aria-controls="site-nav"><span></span><span></span></button
    ><nav id="site-nav" aria-label="Primary navigation">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}<a
        class="button button-primary download"
        href={`${base}download/`}>Download <ArrowRight size={16} /></a
      >
    </nav>
  </div>
</header>
<script>
  const button = document.querySelector<HTMLButtonElement>(".menu-button");
  const nav = document.querySelector<HTMLElement>("#site-nav");
  const header = document.querySelector<HTMLElement>(".site-header");
  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
  let scrollAnchor = window.scrollY;
  let framePending = false;
  function updateHeader() {
    const y = Math.max(0, window.scrollY);
    header?.toggleAttribute("data-scrolled", y > 24);
    const anchorTarget = document.getElementById(location.hash.slice(1));
    const atAnchor =
      anchorTarget &&
      header &&
      Math.abs(anchorTarget.getBoundingClientRect().top - header.offsetHeight) <
        24;
    const keepVisible =
      y < 160 ||
      atAnchor ||
      reducedMotion.matches ||
      nav?.hasAttribute("data-open") ||
      header?.querySelector(":focus-visible");
    if (keepVisible) header?.removeAttribute("data-hidden");
    else if (Math.abs(y - scrollAnchor) > 48)
      header?.toggleAttribute("data-hidden", y > scrollAnchor);
    if (keepVisible || Math.abs(y - scrollAnchor) > 48) scrollAnchor = y;
    framePending = false;
  }
  window.addEventListener(
    "scroll",
    () => {
      if (!framePending) {
        framePending = true;
        requestAnimationFrame(updateHeader);
      }
    },
    { passive: true },
  );
  window.addEventListener("resize", updateHeader);
  reducedMotion.addEventListener("change", updateHeader);
  header?.addEventListener("focusin", () =>
    header.removeAttribute("data-hidden"),
  );
  updateHeader();
  function updateNavigation() {
    const current = location.pathname.replace(/\/$/, "") || "/";
    nav?.querySelectorAll("a").forEach((link) => {
      const target = new URL(link.href, location.href);
      const path = target.pathname.replace(/\/$/, "") || "/";
      const active = !target.hash && (current === path || (path.endsWith("/blog") && current.startsWith(`${path}/`)));
      if (active) link.setAttribute("aria-current", current === path ? "page" : "true");
      else link.removeAttribute("aria-current");
    });
  }
  updateNavigation();
  document.addEventListener("astro:after-swap", () => {
    closeMenu();
    scrollAnchor = window.scrollY;
    header?.removeAttribute("data-hidden");
    updateHeader();
    updateNavigation();
  });
  function closeMenu() {
    nav?.removeAttribute("data-open");
    button?.setAttribute("aria-expanded", "false");
    button?.setAttribute("aria-label", "Open navigation");
  }
  button?.addEventListener("click", () => {
    const open = button.getAttribute("aria-expanded") === "true";
    button.setAttribute("aria-expanded", String(!open));
    button.setAttribute(
      "aria-label",
      open ? "Open navigation" : "Close navigation",
    );
    nav?.toggleAttribute("data-open", !open);
    header?.removeAttribute("data-hidden");
  });
  nav
    ?.querySelectorAll("a")
    .forEach((link) => link.addEventListener("click", closeMenu));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeMenu();
  });
</script>
<style>
  .site-header {
    height: 76px;
    display: flex;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 30;
    background: #0b10202b;
    opacity: 1;
    transition:
      transform 320ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 220ms ease,
      background-color 180ms ease;
  }
  .site-header[data-scrolled] {
    background: #0b1020f2;
    backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 #718bff20;
  }
  .site-header[data-hidden] {
    transform: translateY(calc(-100% - 8px));
    opacity: 0;
    pointer-events: none;
  }
  .nav-wrap {
    display: flex;
    align-items: center;
  }
  nav {
    display: flex;
    align-items: center;
    flex: 1;
    gap: 30px;
    margin-left: 80px;
    color: #d5d8ef;
    font-size: 13px;
  }
  nav > a:not(.button):hover {
    color: #8da0ff;
  }
  nav > a[aria-current]:not(.button) {
    color: var(--blue-bright);
    font-weight: 650;
    position: relative;
  }
  nav > a[aria-current]:not(.button)::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -8px;
    height: 2px;
    background: var(--blue);
  }
  .download {
    margin-left: auto;
    min-height: 40px;
    padding-inline: 18px;
  }
  .menu-button {
    display: none;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
  }
  .menu-button span {
    display: block;
    width: 18px;
    height: 1px;
    margin: 5px auto;
    background: white;
  }
  @media (min-width: 1500px) {
    .site-header {
      height: 90px;
    }
    nav {
      font-size: 16px;
      gap: 36px;
      margin-left: 100px;
    }
    .download {
      min-height: 48px;
      padding-inline: 23px;
    }
  }
  @media (max-width: 1000px) {
    nav {
      margin-left: 40px;
      gap: 22px;
    }
  }
  @media (max-width: 900px) {
    .site-header {
      height: 64px;
    }
    .nav-wrap {
      justify-content: space-between;
    }
    .menu-button {
      display: block;
    }
    nav {
      display: none;
      position: absolute;
      z-index: 20;
      top: 64px;
      left: 16px;
      right: 16px;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 8px;
      border: 1px solid var(--line);
      border-radius: 10px;
      margin: 0;
      background: var(--surface);
    }
    nav[data-open] {
      display: flex;
    }
    nav a {
      padding: 13px;
    }
    nav > a[aria-current]:not(.button) {
      background: #718bff14;
      border-radius: 6px;
    }
    nav > a[aria-current]:not(.button)::after {
      display: none;
    }
    .download {
      margin: 6px 0 0;
      justify-content: center;
    }
  }
</style>
