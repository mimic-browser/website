---
import Logo from "./Logo.astro";
import { ArrowRight } from "lucide-astro";
const base = import.meta.env.BASE_URL;
const links = [
  { label: "Features", href: `${base}#features` },
  { label: "Benchmarks", href: `${base}benchmarks/` },
  { label: "Examples", href: `${base}examples/` },
  { label: "Docs", href: `${base}docs/` },
  { label: "About", href: `${base}about/` },
];
---

<header class="site-header">
  <div class="container nav-wrap">
    <a href={base} aria-label="Mimic home"><Logo /></a><button
      class="menu-button"
      type="button"
      aria-label="Open navigation"
      aria-expanded="false"
      aria-controls="site-nav"><span></span><span></span></button
    ><nav id="site-nav" aria-label="Primary navigation">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}<a
        class="button button-primary download"
        href={`${base}download/`}>Download <ArrowRight size={16} /></a>
    </nav>
  </div>
</header>
<script>
  const button = document.querySelector<HTMLButtonElement>(".menu-button");
  const nav = document.querySelector<HTMLElement>("#site-nav");
  function closeMenu() {
    nav?.removeAttribute("data-open");
    button?.setAttribute("aria-expanded", "false");
    button?.setAttribute("aria-label", "Open navigation");
  }
  button?.addEventListener("click", () => {
    const open = button.getAttribute("aria-expanded") === "true";
    button.setAttribute("aria-expanded", String(!open));
    button.setAttribute(
      "aria-label",
      open ? "Open navigation" : "Close navigation",
    );
    nav?.toggleAttribute("data-open", !open);
  });
  nav
    ?.querySelectorAll("a")
    .forEach((link) => link.addEventListener("click", closeMenu));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeMenu();
  });
</script>
<style>
  .site-header {
    height: 76px;
    display: flex;
    align-items: center;
    position: relative;
    z-index: 5;
    background: #0b10202b;
  }
  .nav-wrap {
    display: flex;
    align-items: center;
  }
  nav {
    display: flex;
    align-items: center;
    flex: 1;
    gap: 30px;
    margin-left: 80px;
    color: #d5d8ef;
    font-size: 13px;
  }
  nav > a:not(.button):hover {
    color: #8da0ff;
  }
  .download {
    margin-left: auto;
    min-height: 40px;
    padding-inline: 18px;
  }
  .menu-button {
    display: none;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
  }
  .menu-button span {
    display: block;
    width: 18px;
    height: 1px;
    margin: 5px auto;
    background: white;
  }
  @media (min-width: 1500px) {
    .site-header {
      height: 90px;
    }
    nav {
      font-size: 16px;
      gap: 36px;
      margin-left: 100px;
    }
    .download {
      min-height: 48px;
      padding-inline: 23px;
    }
  }
  @media (max-width: 1000px) {
    nav {
      margin-left: 40px;
      gap: 22px;
    }
  }
  @media (max-width: 760px) {
    .site-header {
      height: 64px;
    }
    .nav-wrap {
      justify-content: space-between;
    }
    .menu-button {
      display: block;
    }
    nav {
      display: none;
      position: absolute;
      z-index: 20;
      top: 64px;
      left: 16px;
      right: 16px;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 8px;
      border: 1px solid var(--line);
      border-radius: 10px;
      margin: 0;
      background: var(--surface);
    }
    nav[data-open] {
      display: flex;
    }
    nav a {
      padding: 13px;
    }
    .download {
      margin: 6px 0 0;
      justify-content: center;
    }
  }
</style>
