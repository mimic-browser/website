---
import {
  FileCode,
  LockKeyhole,
  RotateCw,
  Monitor,
  Layout,
  Puzzle,
  Cpu,
  Film,
  Ellipsis,
} from "lucide-astro";
const { compact = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const overhead = [
  { icon: Monitor, label: "Rendering" },
  { icon: Layout, label: "UI" },
  { icon: Puzzle, label: "Extensions" },
  { icon: Cpu, label: "GPU" },
  { icon: Film, label: "Media" },
  { icon: Ellipsis, label: "Everything else" },
];
---

<!-- Ordinary HTML cards share the base plate's 2051 × 767 coordinates.
     Only the environment and the foreground fingertips are raster assets. -->
<div class:list={["hero-scene", { compact }]}>
  <div class="scene-canvas">
    <img
      class="scene-base"
      src={base + "images/hero-reference-scene.webp"}
      alt=""
      width="2051"
      height="767"
      fetchpriority="high"
      draggable="false"
    />
    <img
      class="mascot-focus"
      src={base + "images/hero-reference-scene.webp"}
      alt=""
      width="2051"
      height="767"
      draggable="false"
    />
    <div class="scene-lighting" aria-hidden="true"></div>
    <div class="scene-ui">
      <section class="heavy-window" aria-label="Full browser overhead">
        <div class="heavy-bar" aria-hidden="true"><i></i><i></i><i></i></div>
        <div class="heavy-content">
          <h2>Heavy browser</h2>
          <ul>
            {
              overhead.map(({ icon: Icon, label }) => (
                <li>
                  <>
                    <Icon size={22} aria-hidden="true" />
                    <span>{label}</span>
                  </>
                </li>
              ))
            }
          </ul>
        </div>
      </section>
      <svg
        class="heavy-connection"
        viewBox="0 0 110 90"
        fill="none"
        aria-hidden="true"
      >
        <path d="M9 16C47 7 83 36 99 72M9 16l8-9M9 16l11 5m79 51-15-8m15 8 1-17"
        ></path>
      </svg>
    </div>
    <div class="mimic-ui">
      <section class="held-window" aria-label="Mimic runtime">
        <div class="window-bar">
          <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
          <div
            class="address-bar"
            aria-label="Page address: https://example.com"
          >
            <LockKeyhole size={16} aria-hidden="true" />
            <span><span class="protocol">https://</span>example.com</span>
            <RotateCw size={15} aria-hidden="true" />
          </div>
        </div>
        <div
          class="document-view"
          aria-label="Document structure of Example Domain"
        >
          <div class="document-root">
            <FileCode size={19} aria-hidden="true" /><span>#document</span><span
              class="dom-label">DOM</span>
          </div>
          <div class="document-tree">
            <div class="element-row"><span class="node-tag">html</span></div>
            <div class="document-branch">
              <div class="element-row"><span class="node-tag">body</span></div>
              <div class="document-branch leaf-nodes">
                <div class="element-row">
                  <span class="node-tag">h1</span><span class="node-text"
                    >Example Domain</span>
                </div>
                <div class="element-row">
                  <span class="node-tag">p</span><span class="node-text muted"
                    >This domain is for use in examples.</span>
                </div>
                <div class="element-row">
                  <span class="node-tag">a</span><span
                    class="node-text link-text">More information &#8599;</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
      <img
        class="scene-grip left-grip"
        src={base + "images/hero-grip-left.png"}
        alt=""
        width="115"
        height="61"
        draggable="false"
      />
      <img
        class="scene-grip right-grip"
        src={base + "images/hero-grip-right.png"}
        alt=""
        width="124"
        height="69"
        draggable="false"
      />
    </div>
  </div>
</div>
<style>
  .hero-scene {
    position: relative;
    width: 100%;
    aspect-ratio: 2051 / 767;
    overflow: hidden;
  }
  .scene-canvas {
    position: absolute;
    inset: 0;
    container-type: inline-size;
  }
  .scene-canvas > * {
    /* One source pixel, scaled by the shared canvas rather than the viewport. */
    --u: calc(100cqw / 2051);
  }
  .scene-base,
  .mascot-focus {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    user-select: none;
  }
  .mascot-focus {
    /* Reuse the plate at a local scale; feather only the surrounding room.
       The original character stays covered, without another generated asset. */
    mask-image:
      linear-gradient(
        90deg,
        transparent 47%,
        #000 50%,
        #000 68%,
        transparent 72%
      ),
      linear-gradient(0deg, transparent 5%, #000 14%, #000 92%, transparent 98%);
    mask-composite: intersect;
  }
  .mascot-focus,
  .mimic-ui {
    transform: scale(1.1);
    transform-origin: 59% 50%;
  }
  .scene-ui,
  .mimic-ui {
    position: absolute;
    inset: 0;
    font-family: var(--sans);
    color: #edf3ff;
    user-select: text;
  }
  .mimic-ui {
    pointer-events: none;
  }
  .scene-lighting {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(
        ellipse 13% 12% at 59% 83%,
        #050b16cc 15%,
        #050b1678 52%,
        transparent 100%
      ),
      linear-gradient(0deg, #050a146c, transparent 26%),
      radial-gradient(
        ellipse 19% 43% at 58% 36%,
        transparent 25%,
        #03081435 68%,
        #03081480 100%
      );
  }
  .heavy-connection {
    position: absolute;
    left: calc(944 * var(--u));
    top: calc(228 * var(--u));
    width: calc(110 * var(--u));
    height: calc(90 * var(--u));
    stroke: #819af0;
    stroke-width: 1.25;
    stroke-linecap: round;
    opacity: 0.8;
    pointer-events: none;
  }
  .held-window {
    position: absolute;
    pointer-events: auto;
    left: calc(919 * var(--u));
    top: calc(338 * var(--u));
    width: calc(500 * var(--u));
    min-height: calc(280 * var(--u));
    isolation: isolate;
    transform-origin: 0 0;
    /* Frame and real HTML contents share the same perspective. */
    transform: rotate(-2deg);
  }
  .held-window::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    border: 1px solid #91b5ff80;
    border-radius: calc(19 * var(--u));
    background: linear-gradient(130deg, #162338, #09121f);
    box-shadow:
      inset 0 1px 0 #fff2,
      0 20px 50px #030a1855;
  }
  .window-bar {
    min-height: calc(58 * var(--u));
    padding: 0 calc(22 * var(--u));
    display: flex;
    align-items: center;
    gap: calc(25 * var(--u));
    position: relative;
  }
  .window-bar::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background: #a2bdff18;
  }
  .lights {
    display: flex;
    gap: calc(10 * var(--u));
  }
  .lights i,
  .heavy-bar i {
    display: block;
    width: calc(17 * var(--u));
    height: calc(17 * var(--u));
    border-radius: 50%;
    background: #ed6872;
    box-shadow: inset 0 1px 1px #fff4;
  }
  .lights i:nth-child(2) {
    background: #e3b750;
  }
  .lights i:nth-child(3) {
    background: #49ad65;
  }
  .address-bar {
    flex: 1;
    min-width: 0;
    height: calc(32 * var(--u));
    display: flex;
    align-items: center;
    gap: calc(10 * var(--u));
    padding: 0 calc(12 * var(--u));
    border: 1px solid #91b5ff1c;
    border-radius: calc(7 * var(--u));
    background: #060e1a70;
    color: #dce7fa;
    font-size: calc(16 * var(--u));
    white-space: nowrap;
  }
  .address-bar :global(svg) {
    width: calc(15 * var(--u));
    height: calc(15 * var(--u));
    flex-shrink: 0;
    color: #8c9fbf;
  }
  .address-bar :global(svg:last-child) {
    margin-left: auto;
  }
  .protocol {
    color: #8c9fbf;
  }
  .document-view {
    padding: calc(16 * var(--u)) calc(25 * var(--u)) calc(20 * var(--u));
    font-size: calc(17 * var(--u));
    line-height: 1.25;
  }
  .document-root {
    display: flex;
    align-items: center;
    gap: calc(9 * var(--u));
    color: #c0cee6;
    margin-bottom: calc(8 * var(--u));
  }
  .document-root :global(svg) {
    width: calc(19 * var(--u));
    height: calc(19 * var(--u));
    color: #91b5ff;
  }
  .dom-label {
    margin-left: auto;
    font-size: calc(11 * var(--u));
    letter-spacing: 0.12em;
    color: #8297b7;
  }
  .document-tree {
    margin-left: calc(9 * var(--u));
  }
  .document-branch {
    margin-left: calc(12 * var(--u));
    padding-left: calc(20 * var(--u));
    border-left: 1px solid #7b9ac333;
  }
  .element-row {
    position: relative;
    display: flex;
    align-items: center;
    gap: calc(12 * var(--u));
    min-height: calc(30 * var(--u));
    white-space: nowrap;
  }
  .document-branch > .element-row::before {
    content: "";
    position: absolute;
    left: calc(-20 * var(--u));
    width: calc(13 * var(--u));
    height: 1px;
    background: #7b9ac333;
  }
  .node-tag {
    color: #97baff;
    font-size: calc(15 * var(--u));
    font-weight: 500;
  }
  .node-tag::before {
    content: "<";
    color: #647b9e;
  }
  .node-tag::after {
    content: ">";
    color: #647b9e;
  }
  .leaf-nodes .node-tag {
    min-width: calc(35 * var(--u));
  }
  .node-text {
    color: #e4ecf9;
  }
  .node-text.muted {
    color: #95a8c4;
    font-size: calc(14 * var(--u));
  }
  .link-text {
    color: #aec7fa;
  }
  .heavy-window {
    position: absolute;
    left: calc(750 * var(--u));
    top: calc(170 * var(--u));
    width: calc(260 * var(--u));
    isolation: isolate;
    color: #bdcde7;
    transform-origin: 0 0;
    transform: matrix(1, -0.08, 0.025, 1, 0, 0);
    opacity: 0.58;
  }
  .heavy-window::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    border: 1px solid #91b5ff52;
    border-radius: calc(15 * var(--u));
    background: linear-gradient(130deg, #162338df, #09121fe8);
    box-shadow:
      inset 0 1px 0 #dbeaff10,
      0 22px 70px #0007;
  }
  .heavy-bar {
    display: flex;
    align-items: center;
    gap: calc(7 * var(--u));
    height: calc(43 * var(--u));
    padding: 0 calc(15 * var(--u));
    border-bottom: 1px solid #829bdc13;
  }
  .heavy-bar i {
    width: calc(11 * var(--u));
    height: calc(11 * var(--u));
    background: #8393bf;
    opacity: 0.7;
  }
  .heavy-content {
    padding: calc(20 * var(--u)) calc(25 * var(--u)) calc(27 * var(--u));
  }
  h2 {
    margin: 0 0 calc(22 * var(--u));
    font-size: calc(21 * var(--u));
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.2;
    white-space: nowrap;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: calc(22 * var(--u));
  }
  li {
    display: flex;
    gap: calc(12 * var(--u));
    align-items: center;
    font-size: calc(16 * var(--u));
    line-height: 1.25;
    color: #b3c4df;
  }
  li :global(svg) {
    width: calc(22 * var(--u));
    height: calc(22 * var(--u));
    flex-shrink: 0;
    color: #90b6ff;
  }
  .scene-grip {
    position: absolute;
    pointer-events: none;
    user-select: none;
    height: auto;
  }
  .left-grip {
    left: calc(1025 * var(--u));
    top: calc(292 * var(--u));
    width: calc(115 * var(--u));
  }
  .right-grip {
    left: calc(1282 * var(--u));
    top: calc(278 * var(--u));
    width: calc(124 * var(--u));
  }
  .compact {
    aspect-ratio: 770 / 697;
  }
  .compact .scene-canvas {
    inset: auto;
    left: -100%;
    top: -10.043%;
    width: 266.364%;
    height: 110.043%;
  }
  .compact .heavy-window {
    left: calc(790 * var(--u));
    top: calc(188 * var(--u));
  }
  .compact .mascot-focus,
  .compact .heavy-connection {
    display: none;
  }
  .compact .mimic-ui {
    transform: none;
  }
  .compact .heavy-window h2 {
    font-size: calc(24 * var(--u));
    margin-bottom: calc(18 * var(--u));
  }
  .compact .heavy-window li {
    font-size: calc(20 * var(--u));
    line-height: 1.15;
  }
  .compact .heavy-window ul {
    gap: calc(15 * var(--u));
  }
  .compact .address-bar {
    font-size: calc(23 * var(--u));
    height: calc(36 * var(--u));
  }
  .compact .address-bar :global(svg) {
    width: calc(20 * var(--u));
    height: calc(20 * var(--u));
  }
  .compact .window-bar {
    gap: calc(16 * var(--u));
  }
  .compact .document-view {
    font-size: calc(23 * var(--u));
    padding-top: calc(12 * var(--u));
  }
  .compact .node-tag {
    font-size: calc(21 * var(--u));
  }
  .compact .node-text.muted {
    font-size: calc(18 * var(--u));
    max-width: calc(290 * var(--u));
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .compact .dom-label {
    font-size: calc(16 * var(--u));
  }
</style>
