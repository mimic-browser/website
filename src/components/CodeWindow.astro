---
import { Copy, Check } from "lucide-astro";
import { codeToHtml } from "shiki";
interface Props {
  title?: string;
  code: string;
  label?: string;
  lang?: string;
  showcase?: boolean;
  compact?: boolean;
}
const {
  title = "Terminal",
  code,
  label = "Copy code",
  lang = "javascript",
  showcase = false,
  compact = false,
} = Astro.props;
const highlighted = await codeToHtml(code, {
  lang,
  theme: {
    name: "mimic-night",
    type: "dark",
    colors: { "editor.background": "#0e121c", "editor.foreground": "#bcc9ed" },
    tokenColors: [
      { scope: ["comment"], settings: { foreground: "#626c83" } },
      {
        scope: ["keyword", "storage.type", "storage.modifier"],
        settings: { foreground: "#d48bba" },
      },
      { scope: ["string"], settings: { foreground: "#95c78d" } },
      {
        scope: ["entity.name.function", "support.function"],
        settings: { foreground: "#8bb8e7" },
      },
      {
        scope: ["variable", "entity.name.type", "support.class"],
        settings: { foreground: "#a9bdea" },
      },
      {
        scope: ["constant.numeric", "constant.language"],
        settings: { foreground: "#c2a5e8" },
      },
      { scope: ["punctuation"], settings: { foreground: "#96a2be" } },
    ],
  },
});
---

<div class:list={["code-window", "panel", { showcase, compact }]}>
  <div class="code-titlebar">
    {!showcase && <span>{title}</span>}
    <button type="button" aria-label={label} data-copy={code}>
      <span class="copy-icon">
        <Copy size={14} strokeWidth={1.7} />
      </span>
      <span class="check-icon">
        <Check size={14} strokeWidth={1.8} />
      </span>
      <span class="copy-label" aria-live="polite">
        Copy
      </span>
    </button>
  </div>
  <div class="highlighted" set:html={highlighted} />
</div>
<script>
  const initialized = new WeakSet<HTMLButtonElement>();
  function initializeCopyButtons() {
    document
      .querySelectorAll<HTMLButtonElement>("[data-copy]")
      .forEach((button) => {
        if (initialized.has(button)) return;
        initialized.add(button);
        button.addEventListener("click", async () => {
          const label = button.querySelector<HTMLElement>(".copy-label");
          try {
            await navigator.clipboard.writeText(button.dataset.copy || "");
            if (label) label.textContent = "Copied";
            button.setAttribute("data-copied", "");
          } catch {
            if (label) label.textContent = "Failed";
          }
          setTimeout(() => {
            if (label) label.textContent = "Copy";
            button.removeAttribute("data-copied");
          }, 1500);
        });
      });
  }
  initializeCopyButtons();
  document.addEventListener("astro:page-load", initializeCopyButtons);
</script>
<style>
  .code-window {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: linear-gradient(120deg, #131724, #0b0f19);
  }
  .code-titlebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    border-bottom: 1px solid var(--line);
    min-height: 44px;
    color: #a8b1cc;
    font-family: var(--sans);
    font-size: 13px;
  }
  button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    width: 92px;
    min-height: 30px;
    padding: 5px 9px;
    border: 1px solid #323a54;
    border-radius: 6px;
    background: #171d2d;
    color: #c8d0ed;
    font-size: 12px;
    cursor: pointer;
    transition: none;
  }
  button:hover {
    background: #252d44;
    color: #eef0ff;
  }
  button:active {
    background: #1d253a;
    color: #eef0ff;
  }
  .copy-label {
    text-align: center;
    white-space: nowrap;
    font-family: var(--sans);
  }
  .copy-icon,
  .check-icon {
    display: inline-flex;
  }
  .check-icon {
    display: none;
  }
  button[data-copied] .copy-icon {
    display: none;
  }
  button[data-copied] .check-icon {
    display: inline-flex;
    color: #9dc9a5;
  }
  .highlighted :global(pre) {
    margin: 0;
    padding: 24px;
    overflow-x: auto;
    overflow-y: hidden;
    border: 0;
    border-radius: 0;
    background: transparent !important;
    font-size: 13px;
    line-height: 1.8;
    tab-size: 2;
  }
  .highlighted :global(code) {
    display: block;
    min-width: max-content;
    font-family: var(--mono);
    white-space: pre;
  }
  .showcase {
    border: 0;
    border-radius: 0;
    background: transparent;
    min-height: 385px;
  }
  .showcase .code-titlebar {
    position: absolute;
    top: 7px;
    right: 12px;
    padding: 0;
    min-height: 30px;
    border: 0;
    z-index: 1;
  }
  .showcase .highlighted :global(pre) {
    padding: 44px 22px 23px;
  }
  @media (min-width: 1500px) {
    .highlighted :global(pre) {
      font-size: 16px;
      padding: 30px;
      line-height: 1.85;
    }
    .code-titlebar {
      padding: 12px 20px;
      font-size: 15px;
    }
    .showcase {
      min-height: 490px;
    }
    .showcase .highlighted :global(pre) {
      padding: 48px 30px 30px;
    }
    .showcase .code-titlebar {
      right: 18px;
    }
    .copy-label {
      text-align: center;
      white-space: nowrap;
      font-size: 14px;
    }
  }
  @media (max-width: 520px) {
    .highlighted :global(pre) {
      padding: 18px;
      font-size: 12px;
    }
    .showcase .highlighted :global(pre) {
      padding: 44px 18px 22px;
    }
    .code-titlebar {
      font-size: 12px;
    }
  }
  .compact {
    border-radius: 6px;
    background: #0d121b;
    box-shadow: none;
  }
  .compact .code-titlebar {
    min-height: 36px;
    padding: 4px 12px;
    font-size: 12px;
    background: #111722;
  }
  .compact button {
    min-height: 28px;
    width: auto;
    padding: 4px 7px;
    border-color: transparent;
    background: transparent;
  }
  .compact button:hover {
    background: #202a3b;
  }
  .compact .highlighted :global(pre) {
    padding: 12px 16px;
    font-size: 13px;
    line-height: 1.55;
  }
  @media (min-width: 1500px) {
    .compact .highlighted :global(pre) {
      font-size: 14px;
    }
    .compact .copy-label {
      font-size: 12px;
    }
  }
  @media (max-width: 520px) {
    .compact .code-titlebar {
      padding: 2px 10px;
    }
    .compact button {
      min-height: 36px;
    }
    .compact .highlighted :global(pre) {
      padding: 12px;
    }
  }
</style>
