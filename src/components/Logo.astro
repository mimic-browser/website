---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<span class="logo" aria-label="Mimic">
  <svg
    class="mascot"
    width="40"
    height="45"
    viewBox="0 0 40 45"
    fill="none"
    aria-hidden="true"
    ><g class="mascot-body"
      ><path
        d="M5 35C3 22 5 5 20 4C35 3 37 21 35 36L30 33L26 40L21 35L16 40L12 34L7 39Z"
        fill="#A6A2FF"></path><g class="mascot-eye"
        ><ellipse cx="21" cy="20" rx="9" ry="11" fill="#ECECFF"></ellipse><g
          class="mascot-pupil"
          ><ellipse cx="23" cy="21" rx="5.8" ry="8" fill="#11142C"
          ></ellipse><ellipse cx="24.5" cy="17" rx="2" ry="2.8" fill="white"
          ></ellipse><circle cx="21" cy="24" r="1" fill="#7C8AFF"></circle></g
        ></g
      ></g
    ></svg
  >
  {
    !compact && (
      <span>
        mimic<span class="boo">.boo</span>
      </span>
    )
  }
</span>
<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--text);
    font-family: var(--display);
    font-size: 26px;
    font-weight: 850;
    letter-spacing: -0.045em;
    line-height: 1;
  }
  .boo {
    color: #778cff;
  }
  .mascot {
    overflow: visible;
    flex: none;
  }
  .mascot-body {
    transform-origin: 20px 24px;
    animation: mascot-float 7s ease-in-out infinite;
  }
  .mascot-eye {
    transform-origin: 21px 20px;
    animation: mascot-blink 8s ease-in-out infinite;
  }
  .mascot-pupil {
    animation: mascot-glance 8s ease-in-out infinite;
  }
  .logo:hover .mascot-body,
  .logo:focus-within .mascot-body {
    animation: mascot-greet 650ms ease-in-out;
  }
  @keyframes mascot-float {
    0%,
    100% {
      transform: translateY(0) rotate(-2deg);
    }
    50% {
      transform: translateY(-2px) rotate(2deg);
    }
  }
  @keyframes mascot-blink {
    0%,
    43%,
    47%,
    100% {
      transform: scaleY(1);
    }
    45% {
      transform: scaleY(0.08);
    }
  }
  @keyframes mascot-glance {
    0%,
    55%,
    85%,
    100% {
      transform: translateX(0);
    }
    62%,
    75% {
      transform: translateX(-2px);
    }
  }
  @keyframes mascot-greet {
    0%,
    100% {
      transform: translateY(0) rotate(0);
    }
    35% {
      transform: translateY(-3px) rotate(-8deg);
    }
    70% {
      transform: translateY(-1px) rotate(6deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mascot-body,
    .mascot-eye,
    .mascot-pupil {
      animation: none !important;
    }
  }
</style>
