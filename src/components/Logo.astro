---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<span class="logo" aria-label="Mimic">
  <svg width="40" height="45" viewBox="0 0 40 45" fill="none" aria-hidden="true"
    ><path
      d="M5 35C3 22 5 5 20 4C35 3 37 21 35 36L30 33L26 40L21 35L16 40L12 34L7 39Z"
      fill="#A6A2FF"></path><ellipse
      cx="21"
      cy="20"
      rx="9"
      ry="11"
      fill="#ECECFF"></ellipse><ellipse
      cx="23"
      cy="21"
      rx="5.8"
      ry="8"
      fill="#11142C"></ellipse><ellipse
      cx="24.5"
      cy="17"
      rx="2"
      ry="2.8"
      fill="white"></ellipse><circle cx="21" cy="24" r="1" fill="#7C8AFF"
    ></circle></svg
  >
  {
    !compact && (
      <span>
        mimic<span class="boo">.boo</span>
      </span>
    )
  }
</span>
<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--text);
    font-family: var(--display);
    font-size: 26px;
    font-weight: 850;
    letter-spacing: -0.045em;
    line-height: 1;
  }
  .boo {
    color: #778cff;
  }
</style>
