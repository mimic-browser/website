---
import { ArrowRight } from "lucide-astro";
const base = import.meta.env.BASE_URL;
---

<div class="hero-download">
  <a class="download-main" href={`${base}sdk/`}
    ><span>Start with the SDK</span><ArrowRight
      size={16}
      aria-hidden="true"
    /></a
  >
</div>
<style>
  .hero-download a::after {
    content: none !important;
  }
  .hero-download {
    display: inline-flex;
    flex-shrink: 0;
    background: var(--blue);
    color: #080e25;
    border: 1px solid #a4b1ff80;
    border-radius: 8px;
    box-shadow: inset 0 1px 0 #fff3;
    font-size: 13px;
    font-weight: 650;
  }
  .download-main {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 18px;
    min-height: 48px;
    color: inherit;
    white-space: nowrap;
    border-radius: 8px;
  }
  .download-main:hover {
    background: #ffffff18;
  }
</style>
