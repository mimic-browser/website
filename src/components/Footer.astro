---
import Logo from "./Logo.astro";
import { Github, Mail } from "lucide-astro";
const base = import.meta.env.BASE_URL;
const repo = "https://github.com/moreveal/mimic";
---

<footer>
  <div class="container footer-top">
    <div class="footer-brand">
      <a href={base}><Logo /></a><p>
        A lightweight browser runtime<br />for modern automation.
      </p>
    </div><nav aria-label="Footer navigation">
      <div>
        <strong>Product</strong>{" "}<a href={`${base}download/`}>Download</a>{
          " "
        }<a href={`${base}#features`}>Features</a>{" "}<a
          href={`${base}#benchmarks`}>Benchmarks</a
        >{" "}<a href={`${base}#use-cases`}>Use cases</a>
      </div><div>
        <strong>Developers</strong>{" "}<a href={`${base}docs/`}
          >Documentation</a
        >{" "}<a href={`${base}examples/`}>Examples</a>{" "}<a href={repo}
          >GitHub</a
        >
      </div><div>
        <strong>Project</strong>{" "}<a href={`${base}about/`}>About</a>{" "}<a
          href={`${base}changelog/`}>Changelog</a
        >{" "}<a href={`${base}license/`}>License</a>{" "}<a
          href={`${base}#contact`}>Contact</a
        >
      </div>
    </nav><div class="footer-note">
      <span>Same internet.<br />Less overhead.</span><div>
        <a href={repo} aria-label="GitHub"><Github size={22} /></a>{" "}<a
          href="mailto:slava@mimic.boo"
          aria-label="Email Slava at slava@mimic.boo"
          title="Email · slava@mimic.boo"><Mail size={22} /></a
        >
      </div>
    </div>
  </div><div class="container footer-bottom">
    <span>© 2026 Mimic</span>{" "}<a href={`${base}privacy/`}>Privacy</a>
  </div>
</footer>
<style>
  footer {
    background: linear-gradient(120deg, #0c111c, #0a0f18);
  }
  .footer-top {
    display: flex;
    justify-content: space-between;
    gap: 40px;
    padding: 28px 0 48px;
  }
  .footer-brand p {
    font-size: 14px;
    line-height: 1.5;
    margin: 10px 0;
    color: var(--muted);
  }
  nav {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 50px;
    padding-top: 12px;
  }
  nav strong {
    display: block;
    margin-bottom: 8px;
    font-size: 14px;
  }
  nav a {
    display: block;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.8;
  }
  nav a:hover {
    color: var(--blue);
  }
  .footer-note {
    padding-top: 8px;
  }
  .footer-note > span {
    display: block;
    font-family: var(--mono);
    font-size: 14px;
    color: #7c96ff;
    text-transform: uppercase;
    transform: rotate(-12deg);
    line-height: 1.6;
  }
  .footer-note > div {
    display: flex;
    justify-content: center;
    gap: 25px;
    margin-top: 26px;
    color: #c2c4ed;
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    border-top: 1px solid var(--line);
    padding-top: 18px;
    padding-bottom: 55px;
    color: var(--muted);
    font-size: 12px;
  }
  @media (min-width: 1500px) {
    .footer-top {
      display: grid;
      grid-template-columns: 1fr 1.6fr 0.7fr;
      gap: 70px;
      padding-top: 32px;
      padding-bottom: 60px;
    }
    nav {
      gap: 65px;
    }
    nav strong {
      font-size: 17px;
      margin-bottom: 15px;
    }
    nav a {
      font-size: 16px;
      line-height: 2;
    }
    .footer-brand p {
      font-size: 18px;
      margin-top: 18px;
    }
    .footer-note > span {
      font-size: 18px;
    }
    .footer-bottom {
      font-size: 14px;
      padding-top: 24px;
      padding-bottom: 50px;
    }
  }
  @media (max-width: 1000px) {
    nav {
      gap: 25px;
    }
    .footer-note {
      display: none;
    }
  }
  @media (max-width: 760px) {
    .footer-top {
      flex-direction: column;
      gap: 16px;
    }
    nav {
      gap: 20px;
    }
    .footer-bottom {
      padding-bottom: 28px;
    }
  }
</style>
