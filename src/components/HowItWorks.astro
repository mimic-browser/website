<script>
  function initializeDemo() {
    const dialog = document.querySelector<HTMLDialogElement>("#how-dialog");
    if (!dialog || dialog.dataset.demoInitialized) return;
    dialog.dataset.demoInitialized = "true";
    const panes = [...dialog.querySelectorAll<HTMLElement>("[data-load]")];
    const preference = matchMedia("(prefers-reduced-motion: reduce)");
    const steps = [
      "Open product",
      "Choose Midnight",
      "Add to bag",
      "Verify cart",
    ];
    let frame = 0;
    let started: number | undefined;
    const paint = (pane: HTMLElement, value: number) => {
      if (pane.dataset.value === String(value)) return;
      pane.dataset.value = String(value);
      pane.style.setProperty("--progress", `${value}%`);
      const stage = Math.min(3, Math.floor(value / 25));
      pane.dataset.stage = String(stage);
      const event = pane.querySelector("[data-runtime-event]");
      if (event) event.textContent = steps[stage];
      const detail = pane.querySelector("[data-action-detail]");
      if (detail)
        detail.textContent = [
          "Run JavaScript and build page state",
          "Update the selected color",
          "Run the click handler and update the cart",
          "Return the cart data to your automation",
        ][stage];
      const number = pane.querySelector("[data-action-number]");
      if (number) number.textContent = `0${stage + 1} / 04`;
      const color = pane.querySelector("[data-selected-color]");
      if (color) color.textContent = stage > 0 ? "Midnight" : "—";

      pane
        .querySelector("[role=progressbar]")
        ?.setAttribute("aria-valuenow", String(value));
      const percent = pane.querySelector("[data-load-percent]");
      const status = pane.querySelector("[data-load-status]");
      if (percent) percent.textContent = `${value}%`;
      if (status)
        status.textContent =
          value === 100 ? "Cart verified · 1 item" : steps[stage];
      pane.querySelectorAll("[data-cart-count]").forEach((count) => {
        count.textContent = stage === 3 ? "1" : "0";
      });
      const total = pane.querySelector("[data-cart-total]");
      if (total) total.textContent = stage === 3 ? "129" : "0";
    };
    const tick = (now: number) => {
      if (!dialog.open) return;
      started ??= now;
      const elapsed = (now - started) % 11000;
      const resetting = !preference.matches && elapsed > 10000;
      dialog.toggleAttribute("data-resetting", resetting);
      panes.forEach((pane) => {
        const duration = pane.dataset.load === "mimic" ? 4600 : 7200;
        paint(
          pane,
          preference.matches
            ? 100
            : elapsed > 10400
              ? 0
              : Math.min(100, Math.floor((elapsed / duration) * 100)),
        );
      });
      if (!preference.matches) frame = requestAnimationFrame(tick);
    };
    const restart = () => {
      cancelAnimationFrame(frame);
      started = undefined;
      if (dialog.open) {
        panes.forEach((pane) => paint(pane, preference.matches ? 100 : 0));
        frame = requestAnimationFrame(tick);
      }
    };
    const observer = new MutationObserver(restart);
    observer.observe(dialog, { attributes: true, attributeFilter: ["open"] });
    preference.addEventListener("change", restart);
    document.addEventListener(
      "astro:before-swap",
      () => {
        cancelAnimationFrame(frame);
        observer.disconnect();
        preference.removeEventListener("change", restart);
      },
      { once: true },
    );
  }
  initializeDemo();
  document.addEventListener("astro:page-load", initializeDemo);
</script>
