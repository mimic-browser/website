---
import {
  X,
  ArrowRight,
  Check,
  Headphones,
  ShoppingBag,
  MousePointer2,
} from "lucide-astro";
import Logo from "./Logo.astro";
const base = import.meta.env.BASE_URL;
---

<dialog id="how-dialog" aria-labelledby="how-title">
  <form method="dialog">
    <button class="dialog-close" aria-label="Close explanation"
      ><X size={23} /></button
    >
  </form>
  <header>
    <span class="eyeline">How Mimic works</span><h2 id="how-title">
      Run the page.<br /><em>Skip the rendering.</em>
    </h2><p class="desktop-intro">
      Both add the item to the cart. Chrome also draws the page for a person to
      see. Mimic runs the page and gives automation its state and data, without
      rendering it.
    </p>
    <p class="mobile-intro">
      Chrome draws the page. Mimic runs its behavior and keeps the same page
      state.
    </p>
  </header>
  <div class="demonstration" aria-label="Illustrated shopping workload">
    <article class="chrome-window" data-load="chrome" data-stage="0">
      <div class="tab-bar">
        <svg viewBox="0 0 48 48" width="27" height="27" aria-label="Chrome"
          ><circle cx="24" cy="24" r="23" fill="#ea4335"></circle><path
            d="M24 24 44 13A23 23 0 0 1 21 47Z"
            fill="#fbbc05"></path><path
            d="m24 24-3 23A23 23 0 0 1 4 12Z"
            fill="#34a853"></path><circle
            cx="24"
            cy="24"
            r="10"
            fill="#4285f4"
            stroke="#fff"
            stroke-width="2"></circle></svg
        ><strong>Chrome</strong><span>×</span>
      </div>
      <div class="url">
        <span>‹ &nbsp; › &nbsp; ↻</span><span class="url-field"
          >shop.example / studio-headphones</span
        ><span>⋮</span>
      </div>
      <div class="shop-preview">
        <div class="shop-nav">
          <strong>FIELD<span> / AUDIO</span></strong><span class="shop-bag"
            ><ShoppingBag size={18} /><b data-cart-count>0</b></span
          >
        </div>
        <div class="shop-product">
          <div class="product-art">
            <Headphones size={116} stroke-width={1.3} /><span>STUDIO / 01</span>
          </div><div class="product-details">
            <small>EVERYDAY SOUND</small><h3>Studio<br />headphones</h3><strong
              >$129</strong
            ><p>Color · <span class="color-name">Midnight</span></p><div
              class="swatches"
            >
              <i></i><i></i><i></i>
            </div><span class="shop-action">Add to bag <span>+</span></span>
          </div>
        </div>
        <div class="cart-receipt">
          <Check size={15} /><span>Studio headphones · Midnight</span><strong
            >$129</strong
          >
        </div>
        <span class="demo-pointer" aria-hidden="true"
          ><MousePointer2 size={23} fill="white" /></span
        >
      </div>
      <div class="browser-pipeline">
        <span>JavaScript</span><ArrowRight size={12} /><span>Page state</span
        ><ArrowRight size={12} /><span class="render-cost">Layout</span
        ><ArrowRight size={12} /><span class="render-cost">Paint</span>
      </div>
      <div class="load-progress">
        <div class="load-heading">
          <span data-load-status>Open product</span><strong data-load-percent
            >0%</strong
          >
        </div><div
          class="loading"
          role="progressbar"
          aria-label="Illustrated Chrome workload"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="0"
        >
          <i></i>
        </div>
      </div>
    </article>
    <article class="mimic-window" data-load="mimic" data-stage="0">
      <div class="tab-bar">
        <Logo compact /><strong>Mimic</strong><span class="runtime-label"
          >CDP runtime</span
        >
      </div>
      <div class="runtime-caption">
        Inside Mimic <span>JavaScript + page state</span>
      </div>
      <div class="runtime-model">
        <div class="state-document">
          <div class="state-title">
            <span>Page state</span><span>DOM</span>
          </div><dl>
            <div><dt>Product</dt><dd>Studio headphones</dd></div><div>
              <dt>Price</dt><dd>$129</dd>
            </div><div>
              <dt>Selected color</dt><dd data-selected-color>—</dd>
            </div><div class="cart-state-row">
              <dt>Cart items</dt><dd data-cart-count>0</dd>
            </div>
          </dl>
        </div>
        <div class="runtime-event">
          <span class="action-caption"
            >Current action <span data-action-number>01 / 04</span></span
          >
          <strong data-runtime-event>Open product</strong>
          <span class="action-detail" data-action-detail
            >Run JavaScript and build page state</span
          >
        </div>
        <div class="no-render">
          <span>No layout pass</span><span>No painting</span><span
            >No pixels to draw</span
          >
        </div>
        <div class="task-result">
          <Check size={19} /><div>
            <span>Returned to your automation</span><strong
              >Cart contains <b data-cart-count>0</b> item</strong
            >
          </div><span class="result-price">$<b data-cart-total>0</b></span>
        </div>
      </div>
      <div class="load-progress">
        <div class="load-heading">
          <span data-load-status>Open product</span><strong data-load-percent
            >0%</strong
          >
        </div><div
          class="loading"
          role="progressbar"
          aria-label="Illustrated Mimic workload"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="0"
        >
          <i></i>
        </div>
      </div>
    </article>
  </div>
  <div class="mobile-demo" aria-label="Illustrated shopping workload">
    <article class="mobile-phone" data-load="chrome" data-stage="0">
      <div class="mobile-browser-name">
        <svg viewBox="0 0 48 48" width="20" height="20" aria-label="Chrome">
          <circle cx="24" cy="24" r="23" fill="#ea4335"></circle>
          <path d="M24 24 44 13A23 23 0 0 1 21 47Z" fill="#fbbc05"></path>
          <path d="m24 24-3 23A23 23 0 0 1 4 12Z" fill="#34a853"></path>
          <circle
            cx="24"
            cy="24"
            r="10"
            fill="#4285f4"
            stroke="#fff"
            stroke-width="2"></circle>
        </svg>
        <strong>Chrome</strong><span>Draws the page</span>
      </div>
      <div class="mobile-phone-screen">
        <div class="mobile-address">shop.example<span>↻</span></div>
        <div class="mobile-store">
          <div class="mobile-store-nav">
            <strong>FIELD / AUDIO</strong>
            <span><ShoppingBag size={14} /><b data-cart-count>0</b></span>
          </div>
          <div class="mobile-product">
            <div class="mobile-product-art">
              <Headphones size={64} stroke-width={1.3} />
            </div>
            <div class="mobile-product-details">
              <h3>Studio headphones</h3><strong>$129</strong>
              <div class="mobile-color">
                <span>Midnight</span><div class="swatches">
                  <i></i><i></i><i></i>
                </div>
              </div>
            </div>
          </div>
          <div class="mobile-bag-action">
            <span class="mobile-add">Add to bag <span>+</span></span>
            <span class="mobile-added"
              ><Check size={14} /> Added to bag <strong>$129</strong></span
            >
          </div>
        </div>
      </div>
      <div class="load-progress">
        <div class="load-heading">
          <span data-load-status>Open product</span><strong data-load-percent
            >0%</strong
          >
        </div>
        <div
          class="loading"
          role="progressbar"
          aria-label="Illustrated Chrome workload"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="0"
        >
          <i></i>
        </div>
      </div>
    </article>
    <article
      class="mobile-runtime mimic-window"
      data-load="mimic"
      data-stage="0"
    >
      <div class="mobile-current-action">
        <span class="action-caption"
          >Current action <span data-action-number>01 / 04</span></span
        >
        <strong data-runtime-event>Open product</strong>
      </div>
      <div class="mobile-state-surface">
        <div class="mobile-runtime-name">
          <Logo compact /><strong>Mimic</strong><span>No rendering</span>
        </div>
        <div class="mobile-state-summary">
          <span>Studio headphones</span><strong>$129</strong>
        </div>
        <dl class="mobile-state-values">
          <div><dt>Color</dt><dd data-selected-color>—</dd></div>
          <div><dt>Cart</dt><dd><b data-cart-count>0</b> item</dd></div>
          <div><dt>Total</dt><dd>$<b data-cart-total>0</b></dd></div>
        </dl>
        <div class="load-progress">
          <div class="load-heading">
            <span data-load-status>Open product</span><strong data-load-percent
              >0%</strong
            >
          </div>
          <div
            class="loading"
            role="progressbar"
            aria-label="Illustrated Mimic workload"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="0"
          >
            <i></i>
          </div>
        </div>
      </div>
    </article>
  </div>
  <div class="demo-controls">
    <span><Check size={16} /> Same result: one item in the cart.</span>
  </div>
  <footer>
    <p>
      Illustrative shop and timing. Mimic does not use Chromium or draw the
      page. Compatibility depends on the behavior your workload needs.
    </p><div class="dialog-actions">
      <a class="button button-primary" href={`${base}docs/`}
        >Explore the runtime <ArrowRight size={17} /></a
      >
    </div>
  </footer>
</dialog>
<style>
  dialog {
    width: min(1320px, calc(100vw - 48px));
    max-height: calc(100dvh - 40px);
    overflow: auto;
    padding: 38px;
    border: 1px solid #647daa70;
    border-radius: 24px;
    color: #eff4ff;
    background:
      radial-gradient(ellipse at 85% 5%, #273e705c, transparent 55%),
      linear-gradient(140deg, #111c2d, #080f1b);
    box-shadow:
      0 35px 120px #000b,
      inset 0 1px #bdcfff28;
  }
  dialog::backdrop {
    background: #020611bc;
    backdrop-filter: blur(12px);
  }
  header {
    max-width: 850px;
  }
  .eyeline {
    font-family: var(--mono);
    color: #98b4ff;
    text-transform: uppercase;
    font-size: 12px;
    letter-spacing: 0.18em;
  }
  .mobile-intro,
  .mobile-demo {
    display: none;
  }
  h2 {
    font-family: var(--display);
    font-size: 42px;
    line-height: 1.12;
    letter-spacing: -0.045em;
    margin: 12px 0 16px;
    font-weight: 750;
  }
  h2 em {
    font-style: normal;
    color: #8da9ff;
  }
  header p {
    max-width: 800px;
    font-size: 16px;
    line-height: 1.6;
    color: #b5c4df;
  }
  .dialog-close {
    position: absolute;
    right: 18px;
    top: 18px;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1px solid #57709c55;
    border-radius: 10px;
    background: #18243c;
    color: #c7d5ee;
    cursor: pointer;
    transition: background-color 0.2s;
  }
  .dialog-close:hover {
    background: #2a3c61;
  }
  .demonstration {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
    margin: 26px 0 14px;
    gap: 22px;
  }
  article {
    min-width: 0;
    border: 1px solid #58749e65;
    border-radius: 14px;
    background: #0b1525;
    overflow: hidden;
    box-shadow:
      0 18px 35px #0005,
      inset 0 1px #c1d5ff15;
    display: flex;
    flex-direction: column;
  }
  .mimic-window {
    border-color: #769aff80;
  }
  .tab-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 13px 17px;
    background: linear-gradient(120deg, #22324c, #132038);
    font-size: 17px;
  }
  .tab-bar > span {
    margin-left: auto;
    color: #8ba0be;
  }
  .tab-bar .runtime-label {
    font-size: 11px;
  }
  .tab-bar :global(svg) {
    width: 25px;
    height: 25px;
  }
  .url {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 13px;
    background: #17243a;
    font-size: 14px;
    color: #a7b8d2;
  }
  .url-field {
    flex: 1;
    min-width: 0;
    border-radius: 20px;
    padding: 6px 10px;
    background: #0c1627;
    font-size: 10px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .shop-preview {
    background: #f1eee8;
    color: #283331;
    position: relative;
    flex: 1;
    min-height: 345px;
  }
  .shop-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 17px 20px;
    border-bottom: 1px solid #d5d4cb;
    font-size: 13px;
    letter-spacing: 0.08em;
  }
  .shop-nav strong > span {
    font-weight: 400;
    font-size: 9px;
    letter-spacing: 0.15em;
  }
  .shop-bag {
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .shop-bag b {
    font-size: 11px;
  }
  .shop-product {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    padding: 23px 20px;
  }
  .product-art {
    min-height: 204px;
    border-radius: 90px 90px 12px 12px;
    background: radial-gradient(ellipse at 50% 40%, #e0c6a4, #c5b49c);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 20px;
    box-shadow: inset 0 1px #fff9;
  }
  .product-art :global(svg) {
    color: #27343b;
    filter: drop-shadow(3px 9px 4px #29303335);
    transform: rotate(-12deg);
  }
  .product-art > span {
    font-size: 8px;
    letter-spacing: 0.18em;
    color: #615644;
  }
  .product-details small {
    font-size: 8px;
    letter-spacing: 0.15em;
    color: #7d837a;
  }
  .product-details h3 {
    font-size: 23px;
    line-height: 1.15;
    letter-spacing: -0.04em;
    margin: 9px 0 11px;
    font-weight: 650;
  }
  .product-details > strong {
    font-size: 17px;
    font-weight: 500;
  }
  .product-details p {
    font-size: 11px;
    margin: 18px 0 9px;
  }
  .swatches {
    display: flex;
    gap: 8px;
  }
  .swatches i {
    width: 17px;
    height: 17px;
    background: #293942;
    border-radius: 50%;
    border: 3px solid #f1eee8;
    box-shadow: 0 0 0 1px #bbbbb5;
    transition: box-shadow 0.3s;
  }
  .swatches i:nth-child(2) {
    background: #bda98e;
  }
  .swatches i:nth-child(3) {
    background: #a5ac9e;
  }
  .shop-action {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 17px;
    background: #293c37;
    color: #f4f3ee;
    font-size: 11px;
    padding: 10px 12px;
    border-radius: 4px;
    transition:
      background-color 0.3s,
      box-shadow 0.3s;
  }
  .cart-receipt {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 11px 16px;
    margin: 0 16px 16px;
    border-radius: 5px;
    background: #e3e6dc;
    border: 1px solid #b5c4ae;
    font-size: 10px;
    opacity: 0;
    transform: translateY(5px);
    transition:
      opacity 0.3s,
      transform 0.3s;
  }
  .cart-receipt strong {
    margin-left: auto;
    white-space: nowrap;
  }
  .demo-pointer {
    position: absolute;
    left: 62%;
    top: 65%;
    color: #293943;
    filter: drop-shadow(1px 2px 2px #0005);
    transition:
      top 0.55s ease,
      left 0.55s ease,
      opacity 0.3s;
    opacity: 0;
    pointer-events: none;
  }
  [data-stage="1"] .demo-pointer {
    opacity: 1;
    left: 60%;
    top: 64%;
  }
  [data-stage="2"] .demo-pointer {
    opacity: 1;
    left: 76%;
    top: 77%;
  }
  [data-stage="1"] .swatches i:first-child,
  [data-stage="2"] .swatches i:first-child,
  [data-stage="3"] .swatches i:first-child {
    box-shadow: 0 0 0 2px #354d41;
  }
  [data-stage="2"] .shop-action {
    background: #47634f;
    box-shadow: 0 0 0 3px #506c4320;
  }
  [data-stage="3"] .cart-receipt {
    opacity: 1;
    transform: none;
  }
  .runtime-caption {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    padding: 15px 17px;
    color: #cad7ee;
    font-size: 12px;
    border-bottom: 1px solid #33496650;
  }
  .runtime-caption > span {
    color: #8399ba;
    font-size: 11px;
  }
  .runtime-code {
    flex: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3px;
    padding: 11px 13px;
  }
  .code-step {
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 7px 9px;
    opacity: 0.4;
    transition:
      opacity 0.3s,
      background-color 0.3s,
      border-color 0.3s;
  }
  .code-step > div {
    display: flex;
    gap: 9px;
    align-items: center;
    font-size: 10px;
    color: #8fa7ce;
  }
  .code-step > div :global(svg) {
    margin-left: auto;
    opacity: 0;
    color: #8baaff;
  }
  .line-number {
    color: #647d9f;
    font-variant-numeric: tabular-nums;
  }
  .code-step pre {
    font-family: var(--mono);
    margin: 5px 0 0;
    font-size: 12px;
    line-height: 1.4;
    white-space: pre-wrap;
    color: #c4d5ef;
    background: none;
    padding: 0;
    border: 0;
  }
  .code-step code {
    font-family: var(--mono);
    background: none;
    padding: 0;
  }
  .code-step[data-active] {
    opacity: 1;
    background: #223b6050;
    border-color: #658bca50;
  }
  .code-step[data-done] {
    opacity: 0.8;
  }
  .code-step[data-done] > div :global(svg) {
    opacity: 1;
  }
  .runtime-state {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 11px 17px;
    border-top: 1px solid #33496650;
    color: #8ba3c6;
    font-size: 11px;
  }
  .runtime-state code {
    font-size: 11px;
    color: #aec5ec;
    background: none;
  }
  .runtime-state b {
    font-weight: 500;
    color: #d2e2ff;
  }
  .load-progress {
    padding: 17px;
    margin-top: auto;
  }
  .load-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
    color: #a7b9d8;
    margin-bottom: 10px;
  }
  .load-heading strong {
    font-family: var(--sans);
    font-variant-numeric: tabular-nums;
    font-size: 14px;
    font-weight: 650;
    color: #efa6b9;
  }
  .mimic-window .load-heading strong {
    color: #9fc2ff;
  }
  .loading {
    height: 8px;
    border-radius: 6px;
    background: #253650;
    box-shadow: inset 0 1px 3px #0005;
    overflow: hidden;
  }
  .loading i {
    display: block;
    height: 100%;
    width: var(--progress, 0%);
    border-radius: 6px;
    background: linear-gradient(90deg, #b96885, #efa6b9);
  }
  .mimic-window .loading i {
    background: linear-gradient(90deg, #4c75e6, #9fc2ff);
  }
  .demo-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
    color: #9fb3d4;
    font-size: 12px;
  }
  .demo-controls > span {
    display: flex;
    gap: 7px;
    align-items: center;
  }
  .demo-controls button {
    display: flex;
    gap: 7px;
    align-items: center;
    background: #1b2b43;
    border: 1px solid #54729b50;
    border-radius: 7px;
    padding: 8px 12px;
    color: #c3d4ef;
    font-size: 12px;
    cursor: pointer;
    transition: background-color 0.2s;
  }
  .demo-controls button:hover {
    background: #2a4164;
  }
  footer {
    border-top: 1px solid #38517150;
    padding-top: 20px;
    margin-top: 20px;
    display: flex;
    align-items: center;
    gap: 28px;
  }
  footer p {
    font-size: 12px;
    line-height: 1.65;
    color: #97abc9;
    flex: 1;
  }
  .dialog-actions {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-shrink: 0;
  }
  @media (max-width: 760px) {
    dialog {
      padding: 28px 18px;
    }
    h2 {
      font-size: 31px;
    }
    header p {
      font-size: 15px;
    }
    .demonstration {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .shop-preview {
      min-height: 345px;
    }
    .runtime-code {
      min-height: 340px;
    }
    .product-details h3 {
      font-size: 21px;
    }
    .product-art :global(svg) {
      width: 95px;
    }
    .shop-product {
      gap: 14px;
      padding-inline: 16px;
    }
    .url > span:first-child {
      display: none;
    }
    .demo-controls {
      align-items: flex-start;
    }
    .demo-controls > span {
      max-width: 180px;
    }
    .demo-controls button {
      white-space: nowrap;
    }
    footer {
      display: block;
    }
    .dialog-actions {
      margin-top: 16px;
    }
  }
  @media (max-width: 480px) {
    dialog {
      width: calc(100vw - 24px);
      padding-inline: 14px;
    }
    .shop-product {
      grid-template-columns: 80px minmax(0, 1fr);
      gap: 12px;
      padding-inline: 12px;
    }
