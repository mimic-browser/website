{
  "name": "mimic-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run test:public && astro check && astro build && npm run test:public && npm run test:release && npm run test:spacing && npm run test:og && npm run test:routes && npm run test:sdk && npm run test:docs",
    "preview": "astro preview",
    "check": "astro check",
    "test:links": "node scripts/check-links.mjs",
    "test:public": "node scripts/check-public-content.mjs",
    "test:routes": "node scripts/check-routes.mjs",
    "test:spacing": "node scripts/check-text-spacing.mjs",
    "test:og": "node --experimental-strip-types scripts/check-blog-og.ts",
    "test:release": "node --test scripts/release.test.mjs && node scripts/check-release.mjs",
    "test:release-switch": "node scripts/check-release-switch.mjs",
    "release:sync": "node scripts/sync-release.mjs",
    "test:sdk": "node scripts/check-sdk.mjs",
    "test:docs": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "astro": "^7.3.2",
    "lucide-astro": "^0.468.0",
    "marked": "^16.2.1",
    "sharp": "0.35.4",
    "shiki": "^3.12.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "parse5": "8.0.0",
    "typescript": "^5.9.2"
  }
}
